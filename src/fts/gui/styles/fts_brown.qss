QFrame#liveTableCard QLabel#liveTableScorer { color:#FFE6CF; background:rgba(176,91,36,0.30); border:1px solid #A85D31; border-radius:7px; padding:5px 7px; font-size:12px; font-weight:900; }
QFrame#liveTableCard QLabel#liveStatus { color:#F2C79F; font-size:11px; font-weight:950; }
QFrame#liveTableCard QPushButton#liveTableResultButton, QFrame#liveTableCard QPushButton#liveTablePrimaryAction { min-height:32px; max-height:34px; background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #B5652C,stop:1 #7C3A1B); color:#FFFFFF; border:1px solid #D18B52; border-radius:8px; font-weight:950; padding:4px 9px; }
QFrame#liveTableCard QPushButton#liveTableSecondaryAction { min-height:30px; max-height:32px; background:rgba(255,255,255,0.07); color:#F1D9C7; border:1px solid #865238; border-radius:7px; font-weight:850; }


/* STARTFIX 129 - kompakter 13-Zoll-Leitstand / Layout-Anpassung */
