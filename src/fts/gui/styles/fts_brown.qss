QPushButton#progressStep { background:#160A2B; color:#CDBBE8; border:1px solid #5E2A8A; }
QPushButton#progressStep[active="true"], QPushButton#progressStep[done="true"] { background:#3A1760; color:#F4EEFF; border-color:#8147C0; }
