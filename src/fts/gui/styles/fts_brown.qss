/* MSBTS 1.0 Alpha 5 - PURPLE EVERYWHERE */
QMainWindow, QWidget#appShell, QWidget#mainContent { background:#070214; color:#F8F3FF; }
QFrame#sidebar { background:#0B041B; border-right:1px solid #4A1D72; }
QFrame#workspaceHeader, QFrame#progressHeader, QFrame#workflowQuickActions {
