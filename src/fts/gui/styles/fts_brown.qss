    border: none;
    min-height: 136px;
    max-height: 136px;
    padding: 0px;
    margin: 0px;
}
QPushButton#navButton { min-height: 31px; }
QLabel#navSectionLabel { margin-top: 2px; margin-bottom: 1px; }
\n\n/* ================================================================\n   MSBTS 1.0 ALPHA 10 - SIDEBAR BRAND ZONE\n   Full logo, no native light frame, no navigation overlap.\n   ================================================================ */\nQFrame#sidebarBrandHeader {\n    background:#0B041B;\n    border:none;\n    min-height:154px;\n    max-height:154px;\n    padding:0px;\n    margin:0px;\n}\nQFrame#sidebarBrandHeader QLabel#brandLogo {\n    background:#0B041B;\n    border:none;\n    min-height:144px;\n    max-height:144px;\n    min-width:0px;\n    padding:0px;\n    margin:0px;\n}\nQFrame#sidebar QPushButton#navButton {\n    min-height:29px;\n    max-height:32px;\n}\nQLabel#navSectionLabel {\n    margin-top:1px;\n    margin-bottom:0px;\n}\n

/* ================================================================
   MSBTS 1.0 ALPHA 11 - COMPACT SIDEBAR LOGO
   Approved target: smaller logo, generous breathing room, no overlap.
   ================================================================ */
QFrame#sidebarBrandHeader {
    background:#0B041B;
    border:none;
    min-height:126px;
    max-height:126px;
    padding:0px;
    margin:0px;
}
QFrame#sidebarBrandHeader QLabel#brandLogo {
    background:#0B041B;
    border:none;
    min-height:110px;
    max-height:110px;
    min-width:0px;
    padding:0px;
    margin:0px;
}
QFrame#sidebar QPushButton#navButton {
    min-height:30px;
    max-height:34px;
}
QLabel#navSectionLabel {
    margin-top:2px;
    margin-bottom:1px;
}
\n\n/* ================================================================\n   MSBTS 1.0 ALPHA 12 - COMPACT SIDEBAR LOGO / FINAL COLLISION FIX\n   One source of truth for the brand header dimensions.\n   ================================================================ */\nQFrame#sidebar {\n    background: #0B041B;\n    border: none;\n    border-right: 1px solid #5B21B6;\n}\nQFrame#sidebar QWidget { background: transparent; }\nQFrame#sidebarBrandHeader {\n    background: #0B041B;\n    border: none;\n    min-height:112px;\n    max-height:112px;\n    padding:0px;\n    margin:0px;\n}\nQFrame#sidebarBrandHeader QLabel#brandLogo {\n    background:#0B041B;\n    border:none;\n    min-height:92px;\n    max-height:92px;\n    min-width:104px;\n    max-width:104px;\n    padding:0px;\n    margin:0px;\n}\nQFrame#sidebar QPushButton#navButton {\n    min-height:30px;\n    max-height:34px;\n    padding:5px 9px;\n    margin:0px;\n}\nQFrame#sidebar QPushButton#navButton:checked {\n    background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #7C19F5,stop:1 #A414FF);\n    color:#FFFFFF;\n    border:1px solid #B54CFF;\n    border-left:4px solid #D67BFF;\n}\nQFrame#sidebar QPushButton#navButton:hover {\n    background:#21103B;\n    color:#FFFFFF;\n    border-color:#6F2CC2;\n}\nQLabel#navSectionLabel, QLabel[sidebarSection="true"] {\n    color:#C83CFF;\n}\nQFrame#navDivider { background:#542187; color:#542187; border:none; }\n

/* ================================================================
   MSBTS 1.0 ALPHA 14 - LEFT NAVIGATION SLIDEBAR
   Logo fixed; navigation scrolls vertically underneath.
   ================================================================ */
QScrollArea#sidebarNavSlider,
QScrollArea#sidebarNavSlider > QWidget > QWidget,
QWidget#sidebarNavSliderContent {
    background:#0B041B;
    border:none;
}
QScrollArea#sidebarNavSlider QScrollBar:vertical {
    background:#0B041B; width:8px; margin:2px 0px 2px 0px; border:none;
}
QScrollArea#sidebarNavSlider QScrollBar::handle:vertical {
    background:#8B20F5; border:1px solid #B54CFF; border-radius:4px; min-height:34px;
}
QScrollArea#sidebarNavSlider QScrollBar::handle:vertical:hover { background:#A414FF; }
QScrollArea#sidebarNavSlider QScrollBar::add-line:vertical,
QScrollArea#sidebarNavSlider QScrollBar::sub-line:vertical,
QScrollArea#sidebarNavSlider QScrollBar::add-page:vertical,
QScrollArea#sidebarNavSlider QScrollBar::sub-page:vertical {
    background:transparent; border:none; height:0px;
}

/* ================================================================
   MSBTS 1.0 ALPHA 15 - PURPLE LEFT NAV SLIDEBAR / macOS VIEWPORT FIX
   ================================================================ */
QScrollArea#sidebarNavSlider {
    background:#120625;
    border:none;
}
QScrollArea#sidebarNavSlider QWidget#qt_scrollarea_viewport,
QScrollArea#sidebarNavSlider > QWidget,
QScrollArea#sidebarNavSlider > QWidget > QWidget,
QWidget#sidebarNavSliderContent {
    background:#120625;
    color:#F6EEFF;
    border:none;
}
QWidget#sidebarNavSliderContent QPushButton#navButton {
    background:transparent;
    color:#F0E6FF;
    border:1px solid transparent;
    border-radius:9px;
}
QWidget#sidebarNavSliderContent QPushButton#navButton:hover {
    background:#281047;
    color:#FFFFFF;
    border-color:#6F2CC2;
}
QWidget#sidebarNavSliderContent QPushButton#navButton:checked {
    background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #7417E6,stop:1 #A414FF);
    color:#FFFFFF;
    border:1px solid #B54CFF;
    border-left:4px solid #E09AFF;
}
QWidget#sidebarNavSliderContent QLabel#navSectionLabel,
QWidget#sidebarNavSliderContent QLabel[sidebarSection="true"] {
    background:transparent;
    color:#D34CFF;
}
QScrollArea#sidebarNavSlider QScrollBar:vertical {
    background:#17082D;
    width:9px;
    margin:2px 1px;
    border:none;
}
QScrollArea#sidebarNavSlider QScrollBar::handle:vertical {
    background:#8B20F5;
    border:1px solid #C04CFF;
    border-radius:4px;
    min-height:34px;
}
QScrollArea#sidebarNavSlider QScrollBar::handle:vertical:hover { background:#A414FF; }
QScrollArea#sidebarNavSlider QScrollBar::add-line:vertical,
QScrollArea#sidebarNavSlider QScrollBar::sub-line:vertical,
QScrollArea#sidebarNavSlider QScrollBar::add-page:vertical,
QScrollArea#sidebarNavSlider QScrollBar::sub-page:vertical {
    background:transparent;
    border:none;
    height:0px;
}

/* ================================================================
   MSBTS 1.0 ALPHA 16 - BRIGHTER / CLEARER LEFT NAV TYPOGRAPHY
   ================================================================ */
QWidget#sidebarNavSliderContent QPushButton#navButton {
    color:#FAF5FF;
    font-weight:700;
}
QWidget#sidebarNavSliderContent QPushButton#navButton:hover,
QWidget#sidebarNavSliderContent QPushButton#navButton:checked {
    color:#FFFFFF;
    font-weight:800;
}
QWidget#sidebarNavSliderContent QLabel#navSectionLabel,
QWidget#sidebarNavSliderContent QLabel[sidebarSection="true"] {
    color:#ED8CFF;
    font-weight:900;
}
QFrame#sidebar QLabel#sidebarProductName { color:#FFFFFF; }
QFrame#sidebar QLabel#sidebarProductSubtitle { color:#E8D9FF; }
QFrame#sidebar QLabel#sidebarStatusTitle { color:#F6EDFF; }
QFrame#sidebar QLabel#sidebarStatusDetail,
QFrame#sidebar QLabel#sidebarVersion { color:#D9C8F2; }

/* ================================================================
   MSBTS 1.0 ALPHA 17 - ACTIVE SIDEBAR TEXT ALWAYS BRIGHT
   Keep navigation labels readable on every page/state.
   ================================================================ */
QFrame#sidebar QPushButton#navButton,
QScrollArea#sidebarNavSlider QPushButton#navButton,
QWidget#sidebarNavSliderContent QPushButton#navButton {
    color:#F7EEFF;
    font-weight:700;
}
QFrame#sidebar QPushButton#navButton:hover,
QScrollArea#sidebarNavSlider QPushButton#navButton:hover,
QWidget#sidebarNavSliderContent QPushButton#navButton:hover {
    color:#FFFFFF;
    font-weight:800;
}
QFrame#sidebar QPushButton#navButton:checked,
QScrollArea#sidebarNavSlider QPushButton#navButton:checked,
QWidget#sidebarNavSliderContent QPushButton#navButton:checked {
    color:#FFFFFF;
    font-weight:900;
}
QFrame#sidebar QLabel#navSection,
QFrame#sidebar QLabel#navSectionLabel,
QFrame#sidebar QLabel[sidebarSection="true"] {
    color:#F09BFF;
    font-weight:900;
}


/* ================================================================
   MSBTS 1.0 ALPHA 18 - MAXIMUM SIDEBAR LEGIBILITY
   Final fallback for navigation text on dark purple background.
   ================================================================ */
QScrollArea#sidebarNavSlider QPushButton#navButton,
QWidget#sidebarNavSliderContent QPushButton#navButton {
    color:#FFF9FF;
    font-weight:750;
}
QScrollArea#sidebarNavSlider QPushButton#navButton:hover,
QWidget#sidebarNavSliderContent QPushButton#navButton:hover,
QScrollArea#sidebarNavSlider QPushButton#navButton:checked,
QWidget#sidebarNavSliderContent QPushButton#navButton:checked {
    color:#FFFFFF;
    font-weight:900;
}
QScrollArea#sidebarNavSlider QLabel#navSectionLabel,
QWidget#sidebarNavSliderContent QLabel#navSectionLabel,
QWidget#sidebarNavSliderContent QLabel[sidebarSection="true"] {
    color:#F3B2FF;
    font-weight:900;
}

/* ================================================================
   MSBTS 1.0 ALPHA 19 - PURPLE READABILITY / ALL WORKSPACES
   Brighter labels and controls across participant, groups, schedule,
   referees, tournament day, documents, presentation and settings.
   ================================================================ */
QWidget#mainContent QLabel,
QStackedWidget#pageStack QLabel,
QScrollArea#pageScrollArea QLabel {
    color:#F5EEFF;
}
QLabel#pageTitle,
QLabel#cardTitle,
QLabel#heroTitle,
QLabel#sectionTitle,
QLabel#panelTitle,
QLabel#dialogTitle {
    color:#FFFFFF;
    font-weight:900;
}
QLabel#pageSubtitle,
QLabel#cardSubtitle,
QLabel#heroSubtitle,
QLabel#mutedText,
QLabel#dialogHint,
QLabel#helperText,
QLabel#emptyStateText {
    color:#DCCFF2;
}
QLabel#eyebrow,
QLabel#sectionEyebrow,
QLabel#cardEyebrow,
QLabel#participantEyebrow,
QLabel#groupEyebrow,
QLabel#scheduleEyebrow {
    color:#F09BFF;
    font-weight:900;
}
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit,
QPlainTextEdit,
QTextEdit {
    color:#FFF9FF;
    selection-color:#FFFFFF;
    selection-background-color:#8B20F5;
}
QLineEdit::placeholder,
QPlainTextEdit::placeholder,
QTextEdit::placeholder {
    color:#BFAFD5;
}
QCheckBox,
QRadioButton {
    color:#F4ECFF;
}
QPushButton {
    color:#F8F2FF;
}
QPushButton:disabled {
    color:#88799F;
}
QTableView,
QTableWidget,
QTreeView,
QListView,
QListWidget {
    color:#F8F2FF;
    alternate-background-color:#120625;
    selection-color:#FFFFFF;
    selection-background-color:#7420D5;
}
QHeaderView::section {
    color:#F7EDFF;
    font-weight:800;
}
QTabBar::tab {
    color:#DCCFF2;
}
QTabBar::tab:selected {
    color:#FFFFFF;
    font-weight:900;
}
QGroupBox {
    color:#F5EEFF;
    font-weight:800;
}
QToolTip {
    color:#FFFFFF;
    background:#24103D;
    border:1px solid #8B35D1;
}
/* Keep warm accent labels intentional but brighter. */
QLabel#participantCount,
QLabel#footerHint,
QLabel#summaryValue,
QLabel#nextStepEyebrow {
    color:#F4CF9C;
}
/* Readability on active workflow and action buttons. */
QPushButton#workflowButton,
QPushButton#primaryButton,
QPushButton#participantAddButton,
QPushButton#nextActionButton {
    color:#FFFFFF;
    font-weight:900;
}


/* MSBTS ALPHA 22 - macOS dialog readability safeguard */
QMessageBox { background-color:#160629; color:#FFFFFF; }
QMessageBox QLabel { color:#FFFFFF; background:transparent; font-weight:700; }
QMessageBox QPushButton { background:#8D16F5; color:#FFFFFF; border:1px solid #C45CFF; border-radius:8px; min-width:110px; padding:7px 16px; font-weight:900; }
QMessageBox QPushButton:hover { background:#A62BFF; }
