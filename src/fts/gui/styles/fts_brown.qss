    background:#6E1BC7;
    color:#FFFFFF;
}

/* Universal cards / inputs */
QFrame#surfaceCard, QFrame#workspaceCard, QFrame#sectionCard, QFrame#statCard,
QGroupBox {
    background:#100722;
    color:#F7F2FF;
    border:1px solid #4E2477;
    border-radius:12px;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit {
    background:#0C061A;
    color:#F7F2FF;
    border:1px solid #572985;
    border-radius:8px;
    padding:6px 9px;
    selection-background-color:#7A23D0;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus {
    border:1px solid #C13DFF;
}
QPushButton {
    background:#170A31;
    color:#F8F3FF;
    border:1px solid #5C2B88;
    border-radius:9px;
    padding:7px 12px;
}
QPushButton:hover { background:#281047; border-color:#A93BE8; }
QPushButton:pressed { background:#3A1468; }

QAbstractScrollArea,
QAbstractItemView,
QTableWidget,
QTableView,
QTreeView,
QListView,
QListWidget,
QTextEdit,
QTextBrowser {
    background:#090419;
    color:#F6F1FF;
    border-color:#4C2372;
    alternate-background-color:#0F0722;
    selection-background-color:#7020C2;
    selection-color:#FFFFFF;
}
QHeaderView::section,
QTableCornerButton::section {
    background:#1A0C35;
    color:#F6EEFF;
    border:none;
    border-right:1px solid #55277D;
    border-bottom:1px solid #55277D;
    padding:7px 9px;
}
QTableWidget::item, QTableView::item {
    background:#090419;
    color:#F6F1FF;
    border-bottom:1px solid #29123F;
}
QTableWidget::item:alternate, QTableView::item:alternate { background:#0F0722; }
QTableWidget::item:selected, QTableView::item:selected { background:#7020C2; color:#FFFFFF; }
QScrollBar:vertical, QScrollBar:horizontal { background:#05020D; border:none; margin:0; }
QScrollBar:vertical { width:11px; }
QScrollBar:horizontal { height:11px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background:#6F2CAD;
    border:1px solid #A646E5;
    border-radius:5px;
    min-height:30px;
    min-width:30px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background:#9639E0; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background:#05020D; border:none; width:0; height:0;
}
QAbstractScrollArea::corner { background:#05020D; border:none; }
QStatusBar {
    background:#05020D;
    color:#CDBBE5;
    border:none;
    border-top:1px solid #3D195E;
}


