QWidget#mainContent[liveMode="true"] QFrame#liveTableCard QLabel,
QWidget#mainContent[liveMode="true"] QFrame#liveTableCard[tableNumber="1"] QLabel#liveTableTitle,
QWidget#mainContent[liveMode="true"] QFrame#liveTableCard[tableNumber="2"] QLabel#liveTableTitle,
QWidget#mainContent[liveMode="true"] QFrame#liveTableCard[tableNumber="3"] QLabel#liveTableTitle { color:#FFF7F0; background:transparent; }
