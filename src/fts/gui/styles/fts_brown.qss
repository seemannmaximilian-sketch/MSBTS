QLabel#dashboardArenaBadge {
    background: rgba(255,248,241,0.11);
    border: 1px solid rgba(255,240,228,0.28);
    padding: 10px 14px;
}
QFrame#dashboardStatCard[tone="violet"],
QFrame#dashboardStatCard[tone="bronze"],
QFrame#dashboardStatCard[tone="green"],
QFrame#dashboardStatCard[tone="rose"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #FFFDFC, stop:0.60 #FAF0E7, stop:1 #E9D0BC);
