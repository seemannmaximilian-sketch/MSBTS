    selection-background-color:#8D2CFF; selection-color:#FFFFFF;
}
QFrame#participantToolbar QLineEdit:focus, QFrame#participantToolbar QComboBox:focus { border:1px solid #B66F3D; }
QFrame#participantToolbar QComboBox QAbstractItemView {
    background:#160A2B; color:#FAF7FF; border:1px solid #7132A8; selection-background-color:#8D2CFF; selection-color:#FFFFFF;
}
QPushButton#participantAddButton {
    background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #A85B29,stop:1 #743519);
    color:#FFFFFF; border:1px solid #C97A42; border-radius:9px; min-height:32px; padding:0 14px; font-weight:900;
}
QFrame#participantToolbar QPushButton#secondaryButton,
QFrame#participantToolbar QPushButton#dangerButton,
QFrame#participantToolbar QToolButton#secondaryToolButton {
    background:#21103B; color:#EFE5FF; border:1px solid #7440B0; border-radius:9px; min-height:32px; padding:0 12px; font-weight:800;
}
QFrame#participantToolbar QPushButton#secondaryButton:hover,
QFrame#participantToolbar QPushButton#dangerButton:hover,
QFrame#participantToolbar QToolButton#secondaryToolButton:hover { background:#321653; border-color:#B34CFF; color:#FFFFFF; }
QFrame#participantListCard {
    background:rgba(40,21,14,0.94); border:1px solid #7337B4; border-radius:14px;
}
QLabel#participantListHeading { color:#E7B98F; background:transparent; }
QListWidget#participantList {
    background:#090619; color:#F4EEFF; border:1px solid #7440B0; border-radius:10px; padding:5px; outline:none;
    alternate-background-color:#28160F;
}
QListWidget#participantList::item { border-bottom:1px solid #3A1760; padding:10px 11px; color:#F4EEFF; }
QListWidget#participantList::item:alternate { background:#28160F; }
QListWidget#participantList::item:hover { background:#3A2016; border-radius:7px; }
QListWidget#participantList::item:selected { background:#8D2CFF; color:#FFFFFF; border:1px solid #9D38F5; border-radius:7px; }
QLabel#participantCount { color:#E5C4A9; font-size:12px; font-weight:900; padding:4px 8px; }
QFrame#participantListCard QScrollBar:vertical { background:#1C0F0A; width:10px; margin:2px; }
QFrame#participantListCard QScrollBar::handle:vertical { background:#7440B0; min-height:28px; border-radius:4px; }
QFrame#participantListCard QScrollBar::add-line:vertical, QFrame#participantListCard QScrollBar::sub-line:vertical { height:0px; }

/* STARTFIX 150 - Spielplan-Finalschliff: keine hellen Restflaechen */
QWidget#competitionPage QHeaderView {
    background:#090619;
    color:#EFE5FF;
    border:none;
}
QWidget#competitionPage QHeaderView::section {
    background:#201044;
    color:#EFE5FF;
    border:none;
    border-right:1px solid #7440B0;
    border-bottom:1px solid #7440B0;
    padding:7px;
    font-weight:900;
}
QWidget#competitionPage QTableWidget,
QWidget#competitionPage QTableView,
QWidget#competitionPage QAbstractScrollArea {
    background:#090619;
    color:#F4EEFF;
}
QWidget#competitionPage QTableWidget QWidget#qt_scrollarea_viewport,
QWidget#competitionPage QTableView QWidget#qt_scrollarea_viewport {
    background:#090619;
}

/* Globaler unterer Statusbereich im gleichen Braun/Bronze-System. */
QStatusBar {
    background:#070512;
    color:#E7C8AE;
    border-top:1px solid #7337B4;
}
QStatusBar QLabel {
    color:#E7C8AE;
    background:transparent;
}
QStatusBar::item { border:none; }

/* STARTFIX 160 - Compact Release Theme
   Final cross-platform dark-brown / bronze shell.  These rules intentionally
   live at the very end of the stylesheet so macOS/Windows/Linux native widget
   defaults cannot re-introduce grey or light surfaces in the release build. */
QMainWindow,
QWidget#appShell {
    background: #160B07;
    color: #F7E9DD;
}
QFrame#sidebar {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #1B0D08, stop:0.52 #24120C, stop:1 #160B07);
    border: none;
    border-right: 1px solid #60361F;
}
QFrame#sidebar QLabel { background: transparent; }
QLabel#sidebarProductName { color: #FFF5EA; font-weight: 900; }
QLabel#sidebarProductSubtitle { color: #E2C2A7; }
QLabel#navSectionLabel,
QLabel[sidebarSection="true"] {
    color: #D89155;
    background: transparent;
    font-weight: 900;
}
QFrame#navDivider { background: #7337B4; color: #7337B4; border: none; }
QPushButton#navButton {
    background: #2B170F;
    color: #F6E6D8;
    border: 1px solid #4E2D1D;
    border-radius: 8px;
    text-align: left;
    padding: 7px 11px;
    font-weight: 750;
}
QPushButton#navButton:hover {
    background: #2A1248;
    color: #FFFFFF;
    border-color: #815034;
}
QPushButton#navButton:checked {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #A45B2A,stop:1 #6F3319);
    color: #FFFFFF;
    border: 1px solid #B85CFF;
    font-weight: 900;
}
QFrame#sidebarStatusCard {
    background: #140925;
    border: 1px solid #7337B4;
    border-radius: 9px;
}
QLabel#sidebarStatusTitle { color: #F0C8A6; font-weight: 900; }
QLabel#sidebarStatusDetail { color: #CBA98E; }

/* Welcome/start screen of both normal and portable builds. */
QWidget#startPage {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #160B07, stop:0.55 #2A160D, stop:1 #120805);
    color: #F7E9DD;
}
QFrame#startPageShell {
    background: rgba(38,19,12,0.96);
    border: 1px solid #7A472D;
    border-radius: 14px;
}
QFrame#startPageShell QLabel { color: #F7E9DD; background: transparent; }
QPushButton#startPrimaryButton {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #A85B29,stop:1 #743519);
    color: #FFFFFF;
    border: 1px solid #C97A42;
    border-radius: 9px;
    font-weight: 900;
}
QPushButton#startPrimaryButton:hover { background: #B66530; border-color: #D68A4D; }
QPushButton#startSecondaryButton {
    background: #21103B;
    color: #EFE5FF;
    border: 1px solid #7440B0;
    border-radius: 9px;
    font-weight: 800;
}
QPushButton#startSecondaryButton:hover { background: #2A1248; border-color: #B34CFF; color: #FFFFFF; }

/* Release-wide controls: keep native platform themes from painting grey buttons. */
QWidget#mainContent QPushButton:not(#progressStep):not(#workflowQuickButton):not(#dashboardNextActionButton):not(#dashboardActionPrimary):not(#primaryButton):not(#primaryAction):not(#workspacePrimaryAction):not(#participantAddButton):not(#liveOperatorFocusAction):not(#liveTableResultButton):not(#liveTablePrimaryAction) {
    background: #21103B;
    color: #EFE5FF;
    border: 1px solid #7440B0;
}
QWidget#mainContent QPushButton:hover {
    border-color: #B34CFF;
}
QStatusBar {
    background: #160B07;
    color: #E7C8AE;
    border-top: 1px solid #7337B4;
}
QStatusBar QLabel { background: transparent; color: #E7C8AE; }

/* STARTFIX 161 - FINAL BROWN SHELL
   Einheitliche Braun/Bronze-Huelle fuer macOS, Windows und Linux.
   Diese Regeln stehen absichtlich zuletzt, damit native Plattform-Styles
   keine grauen Flaechen oder hellen Navigationszustaende mehr einblenden. */
QMainWindow,
QWidget#appShell,
QWidget#mainContent {
    background: #160B07;
    color: #F7E9DD;
}

/* Komplette linke Navigation */
QFrame#sidebar {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #180B07, stop:0.48 #24120C, stop:1 #120805);
    border: none;
    border-right: 1px solid #7337B4;
}
QFrame#sidebar QWidget { background: transparent; }
QFrame#sidebar QLabel { background: transparent; color: #E9D7C8; }
QLabel#sidebarProductName { color: #FFF7EF; }
QLabel#sidebarProductSubtitle { color: #D8B69A; }
QLabel#navSectionLabel,
QLabel[sidebarSection="true"] { color: #E1A166; font-weight: 900; }
QFrame#navDivider { background: #7337B4; color: #7337B4; border: none; }
QPushButton#navButton {
    background: #100824;
    color: #F4E2D3;
    border: 1px solid #5B3523;
    border-left: 3px solid #5B3523;
    border-radius: 9px;
    padding: 8px 11px;
    text-align: left;
    font-weight: 750;
}
QPushButton#navButton:hover {
    background: #2A1248;
    color: #FFFFFF;
    border-color: #99603A;
    border-left-color: #C17642;
}
QPushButton#navButton:checked {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #A85B29, stop:0.58 #8A431F, stop:1 #653019);
    color: #FFFFFF;
    border: 1px solid #C97A42;
    border-left: 4px solid #E0A06B;
    font-weight: 900;
}
QFrame#sidebarStatusCard {
    background: #090619;
    border: 1px solid #7337B4;
    border-radius: 10px;
}
QLabel#sidebarStatusTitle { color: #F3C9A5; }
QLabel#sidebarStatusDetail { color: #CFAE94; }

/* Kopf-, Fortschritts- und Statusbereiche */
QFrame#workspaceHeader,
QFrame#progressHeader,
QFrame#workflowQuickActions {
    background: #090619;
    border: 1px solid #7337B4;
    border-radius: 13px;
}
QLabel#workspaceTitle { color: #FFF7EF; }
QLabel#workspaceSubtitle,
QLabel#workspaceTournament { color: #D8B69A; }
QPushButton#sidebarToggle,
QPushButton#workspaceBackButton {
    background: #21103B;
    color: #EFE5FF;
    border: 1px solid #7440B0;
}
QPushButton#sidebarToggle:hover,
QPushButton#workspaceBackButton:hover { background: #2A1248; border-color: #B34CFF; }

/* Menue und untere Statusleiste */
QMenuBar {
    background: #1A0D08;
    color: #F2DFCF;
    border-bottom: 1px solid #7337B4;
}
QMenuBar::item { background: transparent; color: #F2DFCF; padding: 6px 10px; }
QMenuBar::item:selected { background: #2A1248; color: #FFFFFF; }
QMenu {
    background: #090619;
    color: #F5E3D3;
    border: 1px solid #7337B4;
}
QMenu::item:selected { background: #8D2CFF; color: #FFFFFF; }
QMenu::separator { height: 1px; background: #5A3523; margin: 4px 8px; }
QStatusBar {
    background: #120805;
    color: #E9CDB5;
    border-top: 1px solid #7337B4;
}
QStatusBar QLabel { background: transparent; color: #E9CDB5; }
QStatusBar::item { border: none; }

/* Plattformneutrale Standard-Steuerelemente */
QDialog,
QMessageBox { background: #090619; color: #F7E9DD; }
QDialog QLabel,
QMessageBox QLabel { color: #F2DFCF; }
QDialog QPushButton,
QMessageBox QPushButton,
QDialogButtonBox QPushButton,
QToolButton {
    background: #21103B;
    color: #EFE5FF;
    border: 1px solid #7440B0;
    border-radius: 8px;
}
QDialog QPushButton:hover,
QMessageBox QPushButton:hover,
QDialogButtonBox QPushButton:hover,
QToolButton:hover { background: #2A1248; border-color: #B34CFF; color: #FFFFFF; }
QRadioButton,
QCheckBox { color: #EFD9C6; background: transparent; }
QTabWidget::pane { background: #090619; border: 1px solid #7337B4; }
QTabBar::tab { background: #100824; color: #DCC3AE; border: 1px solid #5B3523; }
QTabBar::tab:selected { background: #8D2CFF; color: #FFFFFF; border-color: #B85CFF; }
QHeaderView::section {
    background: #201044;
    color: #EFE5FF;
    border-color: #7440B0;
}
QScrollBar:vertical,
QScrollBar:horizontal { background: #180C08; }
QScrollBar::handle:vertical,
QScrollBar::handle:horizontal { background: #7440B0; border-radius: 5px; }
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover { background: #915B3A; }

/* STARTFIX 162 - Brown Shell Final Cleanup
   Final cross-platform overrides. Keep native Qt/macOS status/menu surfaces
   from falling back to light grey/white while the application uses the
   approved dark-brown/bronze shell. */
QMainWindow { background:#160B07; }
QWidget#appShell { background:#160B07; }
QWidget#mainContent { background:#160B07; }
QStatusBar {
    background:#070512;
    color:#E7CDB7;
    border:none;
    border-top:1px solid #5F3825;
    min-height:20px;
}
QStatusBar QLabel { background:transparent; color:#E7CDB7; border:none; }
QSizeGrip { background:#070512; width:0px; height:0px; }
QMenuBar { background:#070512; color:#F3E1D2; border-bottom:1px solid #5F3825; }
QMenuBar::item { background:transparent; color:#F3E1D2; }
QMenuBar::item:selected { background:#4A2818; color:#FFFFFF; }
QMenu { background:#140925; color:#F3E1D2; border:1px solid #7337B4; }
QMenu::item:selected { background:#8D2CFF; color:#FFFFFF; }
QScrollArea#pageScrollArea { background:#160B07; border:none; }
QScrollArea#pageScrollArea > QWidget > QWidget { background:#160B07; }
QScrollBar:vertical { background:#140925; }
QScrollBar::handle:vertical { background:#7B36AF; }
QScrollBar:horizontal { background:#140925; }
QScrollBar::handle:horizontal { background:#7B36AF; }


/* STARTFIX 163 - FULL BROWN WORKSPACES
   Final shell guard for all pages.  Especially on macOS the viewport,
   stacked-widget background and abstract-scroll corner can otherwise fall
   back to the native light palette and appear as white strips. */
QMainWindow,
QMainWindow > QWidget,
QWidget#appShell,
QWidget#mainContent,
QStackedWidget#pageStack,
QScrollArea#pageScrollArea,
QWidget#pageScrollViewport,
QAbstractScrollArea,
QAbstractScrollArea > QWidget,
QAbstractScrollArea > QWidget > QWidget {
    background:#160B07;
    color:#F7E9DD;
    border:none;
}
QAbstractScrollArea::corner { background:#160B07; border:none; }
QStatusBar {
    background:#070512;
    color:#E7CDB7;
    border:none;
    border-top:1px solid #5F3825;
}
QStatusBar QLabel { background:transparent; color:#E7CDB7; border:none; }
QSizeGrip { background:#070512; width:0px; height:0px; }

/* Keep page edges and empty layout space brown while preserving intentional
   cream controls/cards that are explicitly styled by their own selectors. */
QWidget#participantPage,
QWidget#phasePage,
QWidget#scorekeeperContent,
QWidget#startPage,
QWidget#dashboardContent {
    background:transparent;
}

/* STARTFIX 164 - FULL BROWN CONTENT
   Remove unintended native cream/white label strips and scrollbar tracks
   across content pages. Intentional ID-specific badges/cards keep their own
   stronger styles. */
QLabel {
    background: transparent;
}

QWidget#scorekeeperContent QLabel#scorekeeperEyebrow,
QWidget#scorekeeperContent QLabel#scorekeeperTitle,
QWidget#scorekeeperContent QLabel#scorekeeperSubtitle,
QWidget#scorekeeperContent QLabel#scorekeeperSectionTitle,
QWidget#scorekeeperContent QLabel#scorekeeperCount,
QWidget#scorekeeperContent QLabel#scorekeeperHintTitle,
QWidget#scorekeeperContent QLabel#scorekeeperHintText,
QWidget#scorekeeperContent QFrame#scorekeeperHero QLabel,
QWidget#scorekeeperContent QFrame#scorekeeperPanel QLabel,
QWidget#scorekeeperContent QFrame#scorekeeperActions QLabel,
QWidget#scorekeeperContent QFrame#scorekeeperHint QLabel {
    background: transparent;
    border: none;
}

QWidget#scorekeeperContent QFrame#scorekeeperHero,
QWidget#scorekeeperContent QFrame#scorekeeperPanel,
QWidget#scorekeeperContent QFrame#scorekeeperActions,
QWidget#scorekeeperContent QFrame#scorekeeperHint {
    background: rgba(43,22,14,0.96);
    border: 1px solid #5E2A8A;
}

QScrollArea#pageScrollArea QScrollBar:vertical,
QScrollArea#pageScrollArea QScrollBar:horizontal,
QAbstractScrollArea QScrollBar:vertical,
QAbstractScrollArea QScrollBar:horizontal {
    background: #180C08;
    border: none;
}
QScrollArea#pageScrollArea QScrollBar::handle:vertical,
QScrollArea#pageScrollArea QScrollBar::handle:horizontal,
QAbstractScrollArea QScrollBar::handle:vertical,
QAbstractScrollArea QScrollBar::handle:horizontal {
    background: #7440B0;
    border: 1px solid #7B36AF;
    border-radius: 5px;
}
QScrollArea#pageScrollArea QScrollBar::add-line,
QScrollArea#pageScrollArea QScrollBar::sub-line,
QAbstractScrollArea QScrollBar::add-line,
QAbstractScrollArea QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    background: #180C08;
    border: none;
}
QScrollArea#pageScrollArea QScrollBar::add-page,
QScrollArea#pageScrollArea QScrollBar::sub-page,
QAbstractScrollArea QScrollBar::add-page,
QAbstractScrollArea QScrollBar::sub-page {
    background: #180C08;
}
QAbstractScrollArea::corner { background:#180C08; border:none; }

/* STARTFIX 165 - Complete Brown UI + Documents Fix
   Final cleanup for assistant, document center, scorekeeper tables and native scroll areas. */
QWidget#scorekeeperContent QLabel#scorekeeperHintTitle,
QWidget#scorekeeperContent QLabel#scorekeeperHintText,
QWidget#scorekeeperContent QLabel#scorekeeperSectionTitle,
QWidget#scorekeeperContent QLabel#scorekeeperCount,
QWidget#scorekeeperContent QLabel#scorekeeperSubtitle,
QWidget#scorekeeperContent QLabel#scorekeeperEyebrow,
QWidget#scorekeeperContent QLabel#scorekeeperTitle {
    background: transparent;
    border: none;
}
QWidget#scorekeeperContent QTableWidget,
QWidget#scorekeeperContent QTableView,
QWidget#scorekeeperContent QAbstractScrollArea,
QWidget#scorekeeperContent QTableWidget QWidget#qt_scrollarea_viewport {
    background: #090619;
    color: #F7E5D5;
}
QWidget#scorekeeperContent QTableCornerButton::section {
    background: #21103B;
    border: none;
    border-right: 1px solid #7337B4;
    border-bottom: 1px solid #7337B4;
}
QWidget#mainContent QScrollBar:vertical,
QWidget#mainContent QScrollBar:horizontal {
    background:#140925;
    border:none;
    margin:0px;
}
QWidget#mainContent QScrollBar::handle:vertical,
QWidget#mainContent QScrollBar::handle:horizontal {
    background:#7B36AF;
    border:1px solid #A94CFF;
    border-radius:5px;
    min-height:28px;
    min-width:28px;
}
QWidget#mainContent QScrollBar::add-line,
QWidget#mainContent QScrollBar::sub-line,
QWidget#mainContent QScrollBar::add-page,
QWidget#mainContent QScrollBar::sub-page {
    background:#140925;
    border:none;
    width:0px;
    height:0px;
}
QWidget#mainContent QAbstractScrollArea::corner { background:#160B07; border:none; }

/* STARTFIX 166 - FINAL NATIVE CONTROLS
   Cross-platform guard against native white/cream viewports, table empty areas,
   scroll tracks and scroll corners on macOS, Windows and Linux. */
QAbstractScrollArea,
QAbstractItemView,
QTableWidget,
QTableView,
QTreeView,
QListView,
QListWidget,
QTextEdit,
QTextBrowser {
    background:#090619;
    color:#F2EBFF;
    border-color:#7337B4;
    alternate-background-color:#28160F;
    selection-background-color:#8D2CFF;
    selection-color:#FFFFFF;
}
QAbstractScrollArea > QWidget#qt_scrollarea_viewport,
QAbstractItemView > QWidget#qt_scrollarea_viewport,
QTableWidget > QWidget#qt_scrollarea_viewport,
QTableView > QWidget#qt_scrollarea_viewport,
QTreeView > QWidget#qt_scrollarea_viewport,
QListView > QWidget#qt_scrollarea_viewport,
QListWidget > QWidget#qt_scrollarea_viewport,
QTextEdit > QWidget#qt_scrollarea_viewport,
QTextBrowser > QWidget#qt_scrollarea_viewport {
    background:#090619;
    color:#F2EBFF;
    border:none;
}
QTableWidget QHeaderView,
QTableView QHeaderView,
QHeaderView {
    background:#201044;
    color:#EFE5FF;
    border:none;
}
QHeaderView::section {
    background:#201044;
    color:#EFE5FF;
    border:none;
    border-right:1px solid #7440B0;
    border-bottom:1px solid #7440B0;
    padding:7px 9px;
}
QTableCornerButton::section {
    background:#201044;
    border:none;
    border-right:1px solid #7440B0;
    border-bottom:1px solid #7440B0;
}
QTableWidget::item,
QTableView::item {
    background:#090619;
    color:#F2EBFF;
    border-bottom:1px solid #3A1760;
}
QTableWidget::item:alternate,
QTableView::item:alternate { background:#28160F; }
QTableWidget::item:selected,
QTableView::item:selected { background:#8D2CFF; color:#FFFFFF; }

/* Native scrollbar chrome - no light macOS gutter or corner. */
QScrollBar:vertical {
    background:#070512;
    width:11px;
    margin:0px;
    border:none;
}
QScrollBar:horizontal {
    background:#070512;
    height:11px;
    margin:0px;
    border:none;
}
QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background:#7B36AF;
    border:1px solid #A94CFF;
    border-radius:5px;
    min-height:30px;
    min-width:30px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover { background:#A4653F; }
QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background:#070512;
    border:none;
    width:0px;
    height:0px;
}
QAbstractScrollArea::corner,
QTableWidget::corner,
QTableView::corner { background:#070512; border:none; }

/* Explicit workspaces observed in the final macOS pass. */
QWidget#competitionPage QTableWidget,
QWidget#competitionPage QTableView,
QWidget#competitionPage QTableWidget > QWidget#qt_scrollarea_viewport,
QWidget#competitionPage QTableView > QWidget#qt_scrollarea_viewport,
QWidget#phasePage QTableWidget,
QWidget#phasePage QTableView,
QWidget#phasePage QTableWidget > QWidget#qt_scrollarea_viewport,
QWidget#phasePage QTableView > QWidget#qt_scrollarea_viewport,
QWidget#scorekeeperContent QTableWidget,
QWidget#scorekeeperContent QTableView,
QWidget#scorekeeperContent QTableWidget > QWidget#qt_scrollarea_viewport,
QWidget#scorekeeperContent QTableView > QWidget#qt_scrollarea_viewport {
    background:#090619;
    color:#F2EBFF;
}
QWidget#competitionPage QTableCornerButton::section,
QWidget#phasePage QTableCornerButton::section,
QWidget#scorekeeperContent QTableCornerButton::section {
    background:#201044;
    border:none;
    border-right:1px solid #7440B0;
    border-bottom:1px solid #7440B0;
}

/* Shell edge guard: empty page margins must never inherit the OS light palette. */
QWidget#mainContent,
QStackedWidget#pageStack,
QScrollArea#pageScrollArea,
QWidget#pageScrollViewport,
QWidget#pageScrollViewport > QWidget {
    background:#160B07;
    border:none;
}

/* STARTFIX 168: final zero-white shell fallback. */
QWidget#appShell, QWidget#mainContent, QStackedWidget#pageStack,
QScrollArea#pageScrollArea, QWidget#pageScrollViewport {
    background: #160B07;
    border: none;
}
QAbstractScrollArea::corner, QTableCornerButton::section {
    background: #070512;
    border: none;
}
QScrollBar:vertical { background:#070512; width:11px; margin:0; border:none; }
QScrollBar:horizontal { background:#070512; height:11px; margin:0; border:none; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background:#7B36AF; border:1px solid #A94CFF; border-radius:5px;
    min-height:30px; min-width:30px;
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background:#070512; border:none; width:0; height:0;
}

/* STARTFIX 169 - UNIFIED BROWN WORKSPACE
   Final cross-page cleanup: all workspace gutters, native page backgrounds,
   blank table areas and scroll chrome use the same brown shell. */
QMainWindow,
QWidget#appShell,
QWidget#mainContent,
QStackedWidget#pageStack,
QScrollArea#pageScrollArea,
QScrollArea#pageScrollArea > QWidget,
QScrollArea#pageScrollArea > QWidget > QWidget,
QWidget#pageScrollViewport {
    background:#160B07;
    border:none;
}
QWidget#mainContent QAbstractScrollArea,
QWidget#mainContent QAbstractItemView,
QWidget#mainContent QTableWidget,
QWidget#mainContent QTableView,
QWidget#mainContent QListWidget,
QWidget#mainContent QListView {
    background:#090619;
    color:#F2EBFF;
    border-color:#7337B4;
}
QWidget#mainContent QAbstractScrollArea > QWidget#qt_scrollarea_viewport,
QWidget#mainContent QAbstractItemView > QWidget#qt_scrollarea_viewport,
QWidget#mainContent QTableWidget > QWidget#qt_scrollarea_viewport,
QWidget#mainContent QTableView > QWidget#qt_scrollarea_viewport {
    background:#090619;
    border:none;
}
QWidget#mainContent QHeaderView::section,
QWidget#mainContent QTableCornerButton::section {
    background:#4A2818;
    color:#F2EBFF;
    border:none;
    border-right:1px solid #7337B4;
    border-bottom:1px solid #7337B4;
}
QWidget#mainContent QScrollBar:vertical,
QWidget#mainContent QScrollBar:horizontal {
    background:#070512;
    border:none;
    margin:0;
}
QWidget#mainContent QScrollBar:vertical { width:11px; }
QWidget#mainContent QScrollBar:horizontal { height:11px; }
QWidget#mainContent QScrollBar::handle:vertical,
QWidget#mainContent QScrollBar::handle:horizontal {
    background:#7B36AF;
    border:1px solid #A94CFF;
    border-radius:5px;
    min-height:30px;
    min-width:30px;
}
QWidget#mainContent QScrollBar::add-line,
QWidget#mainContent QScrollBar::sub-line,
QWidget#mainContent QScrollBar::add-page,
QWidget#mainContent QScrollBar::sub-page {
    background:#070512;
    border:none;
    width:0;
    height:0;
}
QWidget#mainContent QAbstractScrollArea::corner {
    background:#070512;
    border:none;
}

/* STARTFIX 171 - restore dark premium workspace header/progress after 170.
   Keep only the small workflow status buttons light. */
QFrame#workspaceHeader {
    background: rgba(43,22,14,0.97);
    border: 1px solid #5E2A8A;
    border-radius: 14px;
}
QFrame#workspaceHeader QLabel#workspaceTitle { color:#FFF6ED; background:transparent; border:none; }
QFrame#workspaceHeader QLabel#workspaceSubtitle { color:#D9B79B; background:transparent; border:none; }
QFrame#workspaceHeader QLabel#workspaceTournament,
QFrame#workspaceHeader QLabel#workspaceStatus { color:#E7CDB7; background:transparent; border:none; }
QFrame#workspaceHeader QPushButton#workspaceMenuButton,
QFrame#workspaceHeader QPushButton#workspaceBackButton {
    background:#21103B; color:#FFF4E8; border:1px solid #7440B0; border-radius:9px;
}
QFrame#progressHeader {
    background: rgba(43,22,14,0.97);
    border: 1px solid #5E2A8A;
    border-radius: 14px;
}
QFrame#progressHeader QLabel { background:transparent; color:#DCCBFF; border:none; }
QFrame#progressHeader QLabel#progressTitle { color:#E8A25F; font-weight:900; }
QFrame#progressHeader QPushButton#progressStep {
    background:transparent; color:#D9B79B; border:none;
}
QFrame#progressHeader QPushButton#progressStep[current="true"],
QFrame#progressHeader QPushButton#progressStep[active="true"] {
    background:#9B562A; color:#FFF7EF; border:1px solid #C5793F; border-radius:18px;
}

/* ================================================================
   MSBTS 1.0 ALPHA 2 - PURPLE ARENA
   Final override layer.  Intentionally last so legacy brown rules
   cannot leak into the visible Badminton workspace.
   ================================================================ */
QMainWindow,
QWidget#appShell,
QWidget#mainContent,
QStackedWidget#pageStack,
QScrollArea#pageScrollArea,
QWidget#pageScrollViewport,
QWidget#pageScrollViewport > QWidget {
    background: #080316;
    color: #F8F5FF;
    border: none;
}
QFrame#sidebar {
    background: #09051C;
    border: none;
    border-right: 1px solid #52207E;
}
QLabel#brandLogo {
    background: transparent;
    border: none;
    min-height: 166px;
    min-width: 166px;
    padding: 0px;
}
QLabel#navSection, QLabel#navSectionLabel {
    color: #D989FF;
