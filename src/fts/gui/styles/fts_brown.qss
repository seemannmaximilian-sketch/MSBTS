\n\n/* STARTFIX 105 - premium lower dashboard: workspaces, health and administration */\nQLabel#dashboardSectionHeading {\n    color: #6F4328;\n    font-size: 10px;\n    font-weight: 900;\n    letter-spacing: 1.4px;\n    padding: 4px 0 8px 2px;\n    border-bottom: 1px solid #DFCBBB;\n}\nQPushButton#dashboardQuickCard[premium="true"] {\n    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,\n        stop:0 #FFFDFC, stop:0.68 #FBF5EF, stop:1 #EFDCCB);\n    color: #432719;\n    border: 1px solid #D8BDA8;\n    border-left: 4px solid #A45B29;\n    border-radius: 14px;\n    padding: 10px 15px;\n    text-align: left;\n    font-size: 11px;\n    font-weight: 850;\n}\nQPushButton#dashboardQuickCard[premium="true"]:hover {\n    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,\n        stop:0 #FFF9F4, stop:0.58 #F7E9DD, stop:1 #E8CCB5);\n    border-color: #B7794D;\n    border-left-color: #7D3F1D;\n    color: #321B12;\n}\nQFrame#dashboardHealthPanel {\n    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,\n        stop:0 #FFFDFC, stop:0.75 #F8F0E9, stop:1 #EFE0D4);\n    border: 1px solid #D9C2B0;\n    border-radius: 14px;\n}\nQLabel#dashboardHealthIcon {\n    background: #EAD1BC;\n    color: #713919;\n    border: 1px solid #CFA786;\n    border-radius: 17px;\n    font-weight: 900;\n}\nQFrame#dashboardHealthPanel[state="warning"] {\n    background: #FFF7E8;\n    border-color: #D9B46D;\n}\nQFrame#dashboardHealthPanel[state="error"] {\n    background: #FFF1EE;\n    border-color: #D79B90;\n}\nQLabel#dashboardHealthTitle { color: #6F4328; font-size: 9px; font-weight: 900; letter-spacing: 1.1px; }\nQLabel#dashboardHealthMessage { color: #49352A; font-size: 11px; font-weight: 650; }\nQLabel#dashboardHealthDetails { color: #806A5B; font-size: 10px; font-weight: 750; }\nQFrame#dashboardManagementBar {\n    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,\n        stop:0 #F6EADF, stop:0.55 #FFFDFC, stop:1 #F0DFD1);\n    border: 1px solid #D5BBA7;\n    border-radius: 14px;\n}\nQLabel#dashboardManagementTitle {\n    color: #6E3D22; font-size: 9px; font-weight: 900; letter-spacing: 1.3px;\n}\nQLabel#dashboardManagementSubtitle { color: #7C6758; font-size: 10px; font-weight: 600; }\nQPushButton#dashboardManagementSecondary, QToolButton#dashboardManagementMore {\n    min-height: 34px;\n    border-radius: 9px;\n}\nQPushButton#dashboardManagementPrimary { min-height: 34px; border-radius: 9px; }\n

/* STARTFIX 107 - stronger approved brown/copper dashboard presence */
QFrame#dashboardArena {
    border: 1px solid #6B3822;
    border-radius: 18px;
}
