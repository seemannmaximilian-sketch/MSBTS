/* MSBTS 1.0 Alpha 1 - Purple Badminton Edition */
QMainWindow, QWidget { background: #f3eee8; color: #2f241e; font-family: "Avenir Next", "SF Pro Text", "Helvetica Neue", Arial; font-size: 13px; }
QMenuBar { background: #fffdfa; border-bottom: 1px solid #ded4ca; }
QMenuBar::item { padding: 6px 10px; }
QMenuBar::item:selected, QMenu::item:selected { background: #efe4da; color: #68432f; }
QMenu { background: #fffdfa; border: 1px solid #d8cabe; padding: 5px; }
QStatusBar { background: #fffdfa; border-top: 1px solid #ded4ca; color: #74645a; }
QWidget#appShell, QWidget#mainContent { background: #f3eee8; }
QFrame#sidebar { background: #0B0820; border: none; }
QLabel#brandTitle { color: #fffaf5; font-size: 30px; font-weight: 900; letter-spacing: 1px; }
QLabel#brandEvent { color: #f2e7de; font-size: 13px; font-weight: 800; }
QLabel#brandSubtitle { color: #aa978a; font-size: 10px; font-weight: 700; }
QFrame#navDivider { color: #45352c; background: #45352c; max-height: 1px; border: none; }
QLabel#navSection { color: #9c897c; font-size: 10px; font-weight: 800; margin-top: 10px; padding: 4px 10px; letter-spacing: 1px; }
QPushButton#navButton { background: transparent; color: #eadfd7; border: none; border-radius: 10px; padding: 11px 13px; text-align: left; font-weight: 650; }
QPushButton#navButton:hover { background: #372820; color: #fffaf5; }
QPushButton#navButton:checked { background: #8D2CFF; color: #ffffff; font-weight: 800; }
QFrame#progressHeader { background: #fffdfa; border: 1px solid #ded4ca; border-radius: 15px; }
QLabel#progressTitle { color: #4c382d; font-size: 11px; font-weight: 900; letter-spacing: 1px; }
QLabel#progressSubtitle { color: #95857a; font-size: 11px; }
QPushButton#progressStep { color: #7b6b60; background: #eee7e0; border: 1px solid #e1d8d0; border-radius: 11px; padding: 7px 8px; font-size: 11px; font-weight: 700; }
QPushButton#progressStep[active="true"] { color: #6b432d; background: #ead8ca; border-color: #d7bca8; }
QPushButton#progressStep[current="true"] { color: white; background: #8D2CFF; border-color: #8D2CFF; font-weight: 850; }
QScrollArea, QWidget#dashboardContent { background: #f3eee8; border: none; }
QFrame#dashboardHero { background: #fffdfa; border: 1px solid #ded4ca; border-radius: 16px; }
QLabel#dashboardLogo { background: #f0e5dc; border-radius: 14px; padding: 8px; }
QLabel#eyebrow { color: #9a6b4e; font-size: 10px; font-weight: 900; letter-spacing: 1px; }
QLabel#dashboardTitle { font-size: 27px; font-weight: 850; color: #34251e; }
QLabel#dashboardSubtitle, QLabel#sectionMeta, QLabel#statSubtitle { color: #7e6e64; }
QLabel#statusBadge { background: #e8f1e5; color: #3f6942; padding: 8px 13px; border-radius: 13px; font-weight: 800; }
QFrame#statCard, QFrame#sectionCard { background: #fffdfa; border: 1px solid #ded4ca; border-radius: 15px; }
QFrame#statCard:hover { border-color: #c9ad99; background: #fffaf5; }
QLabel#statIcon { background: #f0e4da; color: #8D2CFF; border-radius: 12px; min-width: 42px; min-height: 42px; font-size: 20px; font-weight: 800; }
QLabel#statTitle { color: #75645a; font-weight: 700; }
QLabel#statValue { color: #6f432d; font-size: 26px; font-weight: 900; }
QLabel#sectionTitle { color: #382820; font-size: 18px; font-weight: 850; }
QLabel#cardSubheading { color: #5c4032; font-size: 13px; font-weight: 850; }
QLabel#infoText { color: #5f5048; }
QLabel#phaseSummary { color: #5f5048; background: #f8f3ee; border: 1px solid #e8ded5; border-radius: 10px; padding: 12px; }
QLabel#progressValue { color: #8D2CFF; font-size: 17px; font-weight: 900; }
QPushButton { background: #fffdfa; color: #5b3a29; border: 1px solid #ccb9aa; border-radius: 9px; padding: 9px 13px; font-weight: 700; }
QPushButton:hover { background: #f3e8df; border-color: #9f6a4b; }
QPushButton:pressed { background: #e8d7c9; }
QPushButton:disabled { background: #eee9e4; color: #a3978e; border-color: #ddd4cc; }
QPushButton#primaryButton { background: #8D2CFF; color: white; border: 1px solid #8D2CFF; font-weight: 800; }
QPushButton#primaryButton:hover { background: #9c6848; }
QPushButton#actionTile, QPushButton#actionTilePrimary { text-align: left; padding: 14px 17px; border-radius: 12px; font-size: 13px; }
QPushButton#actionTile { background: #fffdfa; border: 1px solid #ded2c8; color: #4c372b; }
QPushButton#actionTile:hover { background: #faf3ed; border-color: #b98b6d; }
QPushButton#actionTilePrimary { background: #8D2CFF; color: white; border: 1px solid #8D2CFF; }
QPushButton#actionTilePrimary:hover { background: #9c6848; border-color: #9c6848; }
QLineEdit, QComboBox, QListWidget, QTableWidget, QSpinBox, QTimeEdit, QTextEdit { background: #fffdfa; color: #30251f; border: 1px solid #d3c5ba; border-radius: 8px; padding: 6px; selection-background-color: #a87352; selection-color: white; }
QLineEdit:focus, QComboBox:focus, QListWidget:focus, QTableWidget:focus, QSpinBox:focus, QTimeEdit:focus, QTextEdit:focus { border: 1px solid #9f6848; }
QComboBox QAbstractItemView { background: #fffdfa; selection-background-color: #a87352; selection-color: white; }
QHeaderView::section { background: #ece1d7; color: #4a3327; border: none; border-right: 1px solid #d8c8bb; padding: 8px; font-weight: 800; }
QProgressBar { background: #e8ded5; border: none; border-radius: 8px; min-height: 17px; text-align: center; color: #45362e; font-weight: 750; }
QProgressBar::chunk { background: #956044; border-radius: 8px; }
QFrame#liveTableCard { background: #fffdfa; border: 1px solid #ded4ca; border-radius: 13px; padding: 10px; min-height: 230px; }
QLabel#liveStatus { background: #eee2d7; color: #6f432d; border-radius: 8px; padding: 7px 9px; font-weight: 800; }
QTabWidget::pane { border: 1px solid #d9ccc1; border-radius: 9px; background: #fffdfa; }
QTabBar::tab { background: transparent; padding: 9px 14px; color: #706158; }
QTabBar::tab:hover { color: #8D2CFF; }
QTabBar::tab:selected { color: #8D2CFF; font-weight: 850; border-bottom: 2px solid #8D2CFF; }
QTableWidget { gridline-color: #e8dfd7; alternate-background-color: #faf6f2; }
QToolTip { background: #30251f; color: #fffaf5; border: 1px solid #30251f; padding: 6px; }
QScrollBar:vertical { background: #eee7e0; width: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #b99b86; min-height: 28px; border-radius: 6px; }
QScrollBar::handle:vertical:hover { background: #9f755a; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #eee7e0; height: 12px; margin: 0; }
QScrollBar::handle:horizontal { background: #b99b86; min-width: 28px; border-radius: 6px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }


/* FTS 7.2 – Refined Brown UI */
QMainWindow, QWidget {
    background: #f3eee8;
    color: #2f241e;
    font-family: "Avenir Next", "SF Pro Text", "Helvetica Neue", Arial;
}
QFrame#sidebar { background: #0B0820; }
QLabel#brandTitle { font-size: 30px; letter-spacing: 1px; }
QFrame#navDivider { color: #45352c; background: #45352c; max-height: 1px; border: none; }
QPushButton#navButton { border-radius: 10px; padding: 11px 13px; }
QPushButton#navButton:hover { background: #372820; }
QPushButton#navButton:checked { background: #8D2CFF; font-weight: 800; }

QFrame#progressHeader {
    background: #fffdfa;
    border: 1px solid #ded4ca;
    border-radius: 15px;
}
QLabel#progressSubtitle { color: #95857a; font-size: 11px; }
QPushButton#progressStep {
    border: 1px solid #e1d8d0;
    border-radius: 11px;
    padding: 7px 8px;
}
QPushButton#progressStep[active="true"] {
    color: #6b432d;
    background: #ead8ca;
    border-color: #d7bca8;
}
QPushButton#progressStep[current="true"] {
    color: white;
    background: #8D2CFF;
    border-color: #8D2CFF;
    font-weight: 850;
}

QLabel#dashboardTitle { font-size: 27px; font-weight: 850; }
QFrame#statCard, QFrame#sectionCard {
    background: #fffdfa;
    border: 1px solid #ded4ca;
    border-radius: 15px;
}
QFrame#statCard:hover { border-color: #c9ad99; background: #fffaf5; }
QLabel#statValue { color: #6f432d; font-size: 28px; font-weight: 900; }
QLabel#sectionTitle { font-size: 18px; font-weight: 850; }
QLabel#statusBadge {
    background: #e8f1e5;
    color: #3f6942;
    padding: 8px 13px;
    border-radius: 13px;
    font-weight: 800;
}
QPushButton#actionTilePrimary, QPushButton#actionTile {
    text-align: left;
    padding: 14px 17px;
    border-radius: 12px;
    min-height: 68px;
    font-size: 13px;
}
QPushButton#actionTilePrimary {
    background: #8D2CFF;
    color: white;
    border: 1px solid #8D2CFF;
}
QPushButton#actionTilePrimary:hover { background: #9c6848; }
QPushButton#actionTile {
    background: #fffdfa;
    color: #4c372b;
    border: 1px solid #ded2c8;
}
QPushButton#actionTile:hover { background: #faf3ed; border-color: #b98b6d; }

QLineEdit, QComboBox, QListWidget, QTableWidget, QSpinBox, QTimeEdit, QTextEdit {
    border-radius: 8px;
    padding: 6px;
}
QHeaderView::section { background: #ece1d7; padding: 8px; font-weight: 800; }
QTabBar::tab { padding: 9px 14px; }
QProgressBar { min-height: 17px; font-weight: 750; }

/* FTS 8.0 Milestone 1 */
QFrame#metricCard {
    background: #fffdf9;
    border: 1px solid #dfd1c4;
    border-radius: 14px;
}
QLabel#metricTitle { color: #806a5b; font-size: 12px; font-weight: 700; }
QLabel#metricValue { color: #2c221c; font-size: 28px; font-weight: 800; }
QLabel#metricSubtitle { color: #9a887a; font-size: 11px; }
QPushButton#launchCard, QPushButton#launchCardPrimary {
    text-align: left;
    padding: 16px 18px;
    border-radius: 14px;
    border: 1px solid #d9c7b8;
    background: #fffdf9;
    color: #3a2d25;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#launchCard:hover {
    border: 1px solid #a934ff;
    background: #f7efe8;
}
QPushButton#launchCardPrimary {
    background: #5c4033;
    color: #fffaf5;
    border: 1px solid #5c4033;
}
QPushButton#launchCardPrimary:hover { background: #6b4a3b; }

/* MSTTS 8.0 UI Kit */
QWidget#mainContent { background: #EFE9E3; }
QFrame#sidebar { background: #241A15; }
QLabel#brandTitle { color: #FFF9F4; font-size: 19px; font-weight: 900; letter-spacing: 0.8px; }
QLabel#brandEvent { color: #D9C4B4; font-size: 11px; font-weight: 800; letter-spacing: 1.1px; }
QLabel#brandSubtitle { color: #927D6E; font-size: 10px; font-weight: 800; letter-spacing: 1.4px; }
QPushButton#navButton { min-height: 22px; padding: 11px 12px; border-radius: 9px; font-size: 13px; }
QPushButton#navButton:checked { background: #A934FF; }
QFrame#progressHeader { background: #FFFDFC; border-color: #DDD0C4; border-radius: 14px; }
QPushButton#progressStep { min-height: 34px; padding: 7px 10px; background: #F1EAE4; border-color: #E2D7CD; }
QPushButton#progressStep[current="true"] { background: #A934FF; border-color: #A934FF; }
QFrame#dashboardHero { background: #FFFDFC; border-color: #DDD0C4; border-radius: 18px; }
QLabel#dashboardTitle { font-size: 29px; color: #2B201A; }
QFrame#metricCard, QFrame#sectionCard, QFrame#surfaceCard { background: #FFFDFC; border: 1px solid #DDD0C4; border-radius: 16px; }
QFrame#metricCard { min-height: 92px; }
QLabel#metricValue { color: #5A4033; font-size: 30px; }
QPushButton#launchCard, QPushButton#launchCardPrimary { min-height: 126px; padding: 18px 20px; border-radius: 15px; font-size: 14px; line-height: 1.3; }
QPushButton#launchCard { background: #FFFDFC; border-color: #DDD0C4; }
QPushButton#launchCard:hover { background: #FAF4EE; border-color: #A934FF; }
QPushButton#launchCardPrimary { background: #5A4033; border-color: #5A4033; }
QPushButton#launchCardPrimary:hover { background: #6B4A3B; }
QLabel#pageTitle { color: #2B201A; font-size: 26px; font-weight: 900; }
QLabel#pageSubtitle { color: #7B6A5F; font-size: 13px; }
QLineEdit, QComboBox, QListWidget, QTableWidget, QSpinBox, QTimeEdit, QTextEdit { min-height: 26px; background: #FFFDFC; border-color: #D8CBC0; }
QHeaderView::section { background: #E9E0D7; color: #49362B; min-height: 25px; }
QTableWidget { gridline-color: #E8DED5; alternate-background-color: #FAF6F2; }
QPushButton#primaryButton { background: #A934FF; border-color: #A934FF; min-height: 28px; padding: 10px 16px; }
QPushButton#primaryButton:hover { background: #B4774B; border-color: #B4774B; }
QStatusBar { color: #6F5E53; }

/* MSTTS 9.3 – aufgeräumte Turnierphasen-Seite */
QFrame#surfaceCard, QFrame#workspaceCard {
    background: #fffdfb;
    border: 1px solid #ded3c9;
    border-radius: 14px;
}
QFrame#workspaceCard { min-height: 190px; }
QLabel#cardHeading {
    color: #3a281f;
    font-size: 14px;
    font-weight: 850;
    padding-bottom: 4px;
}
QPushButton#secondaryAction {
    background: #fffdfb;
    color: #5a3827;
    border: 1px solid #8D2CFF;
    font-weight: 800;
}
QPushButton#secondaryAction:hover { background: #f7eee7; }
QTabWidget::pane {
    background: #fffdfb;
    border: 1px solid #ded3c9;
    border-radius: 12px;
    top: -1px;
}
QTabBar::tab {
    background: #f5efe9;
    border: 1px solid #ded3c9;
    border-bottom: none;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    margin-right: 3px;
    padding: 10px 16px;
}
QTabBar::tab:selected {
    background: #fffdfb;
    color: #6d432d;
    border-bottom: 2px solid #fffdfb;
}
QListWidget, QTableWidget { background: #ffffff; }
QPushButton#primaryButton { background: #6b432d; border-color: #6b432d; }
QPushButton#primaryButton:hover { background: #7b5038; border-color: #7b5038; }

/* MSTTS 10.0 Beta 11 – ruhigere, kompakte Gesamtoberfläche */
QMainWindow, QWidget {
    font-size: 12px;
}
QFrame#sidebar {
    background: #241a15;
    border-right: 1px solid #3b2b23;
}
QLabel#brandTitle {
    font-size: 23px;
    font-weight: 900;
    letter-spacing: 0.5px;
}
QLabel#brandEvent {
    font-size: 11px;
}
QLabel#brandSubtitle {
    font-size: 9px;
}
QPushButton#navButton {
    min-height: 18px;
    padding: 9px 11px;
    border-radius: 8px;
    font-size: 12px;
}
QPushButton#navButton:checked {
    background: #9a6848;
    border-left: 3px solid #fff8f1;
    padding-left: 8px;
}
QFrame#progressHeader {
    border-radius: 11px;
}
QFrame#progressHeader[compact="true"] QLabel#progressSubtitle {
    color: transparent;
    max-width: 1px;
}
QLabel#progressTitle {
    font-size: 10px;
}
QPushButton#progressStep {
    padding: 6px 7px;
    border-radius: 8px;
    font-size: 10px;
    min-height: 18px;
}
QFrame#dashboardHero,
QFrame#statCard,
QFrame#sectionCard,
QFrame#surfaceCard {
    border-radius: 12px;
}
QLabel#dashboardTitle,
QLabel#pageTitle {
    font-size: 23px;
    font-weight: 850;
}
QLabel#sectionTitle {
    font-size: 16px;
}
QPushButton {
    padding: 8px 11px;
    border-radius: 8px;
    min-height: 18px;
}
QPushButton#actionTilePrimary,
QPushButton#actionTile {
    min-height: 52px;
    padding: 11px 14px;
    border-radius: 10px;
}
QLineEdit, QComboBox, QListWidget, QTableWidget, QSpinBox, QTimeEdit, QTextEdit {
    padding: 5px;
    border-radius: 7px;
}
QHeaderView::section {
    padding: 7px;
}
QTableWidget {
    gridline-color: #ece4dd;
}
QTabBar::tab {
    padding: 8px 12px;
}
QGroupBox {
    border: 1px solid #ded4ca;
    border-radius: 10px;
    margin-top: 11px;
    padding-top: 10px;
    font-weight: 800;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #5b4032;
}
QDialog {
    background: #f3eee8;
}
QDialogButtonBox QPushButton {
    min-width: 92px;
}

/* Beta 32: klickbare Turnierfortschritt-Schaltflächen */
QPushButton#progressStep {
    margin: 0;
    min-height: 18px;
}
QPushButton#progressStep:hover {
    background: #f2dfd1;
    border-color: #b98563;
}
QPushButton#progressStep[current="true"]:hover {
    background: #9b6543;
    border-color: #9b6543;
}


/* MSTTS 10.0 Beta 36 – modernes Dashboard und neues Logo */
QLabel#brandLogo { background: transparent; padding: 2px; min-height: 120px; }
QLabel#brandTitle { font-size: 23px; qproperty-alignment: AlignCenter; }
QLabel#brandEvent, QLabel#brandSubtitle { qproperty-alignment: AlignCenter; }
QLabel#dashboardWelcome { color: #2b201a; font-size: 27px; font-weight: 900; }
QLabel#dashboardSectionHeading { color: #3a281f; font-size: 13px; font-weight: 900; letter-spacing: 0.7px; padding-bottom: 7px; border-bottom: 1px solid #e5d9cf; }
QLabel#dashboardPercent { color: #2b201a; font-size: 34px; font-weight: 900; padding-top: 8px; }
QPushButton#dashboardAction, QPushButton#dashboardActionPrimary { min-height: 98px; border-radius: 13px; padding: 12px; font-size: 13px; font-weight: 800; }
QPushButton#dashboardAction { background: #fffdfb; border: 1px solid #ddd0c4; color: #3c2a21; }
QPushButton#dashboardAction:hover { background: #faf3ed; border-color: #a934ff; }
QPushButton#dashboardActionPrimary { background: #a65c2a; color: white; border: 1px solid #a65c2a; }
QPushButton#dashboardActionPrimary:hover { background: #b66b37; }
QPushButton#phaseShortcut { background: #f4ede7; border: 1px solid #e1d5ca; color: #5b493e; font-weight: 800; }
QPushButton#phaseShortcut:hover { background: #eadbcf; border-color: #a934ff; color: #6b3c24; }

/* MSTTS 10.0 Beta 41 – Dashboard nach Referenzbild */
QLabel#brandLogo { background: transparent; border: none; }
QLabel#brandTitle {
    background: #f6eee8;
    color: #6f3b22;
    padding: 7px 4px;
    border: none;
    font-size: 21px;
    font-weight: 950;
    letter-spacing: 0.5px;
}
QLabel#brandEvent, QLabel#brandSubtitle {
    background: #f6eee8;
    color: #b16a42;
    padding: 4px 5px;
    border: none;
    font-weight: 900;
}
QLabel#brandSubtitle { color: #6f4c39; }
QWidget#dashboardContent { background: #fbf9f7; }
QLabel#dashboardWelcome { color: #271b15; font-size: 25px; font-weight: 900; }
QLabel#dashboardSubtitle { color: #6f625a; font-size: 12px; margin-bottom: 4px; }
QPushButton#dashboardAction, QPushButton#dashboardActionPrimary {
    min-height: 92px;
    border-radius: 10px;
    padding: 10px;
    font-size: 12px;
    font-weight: 800;
    text-align: center;
}
QPushButton#dashboardAction {
    background: #fffdfb;
    color: #2f241e;
    border: 1px solid #ded5ce;
}
QPushButton#dashboardAction:hover { background: #faf3ed; border-color: #b97a51; }
QPushButton#dashboardActionPrimary {
    background: #a95e2c;
    color: white;
    border: 1px solid #a95e2c;
}
QPushButton#dashboardActionPrimary:hover { background: #b96a35; }
QFrame#dashboardPanel {
    background: #fffdfb;
    border: 1px solid #e2d9d2;
    border-radius: 10px;
    min-height: 230px;
}
QLabel#dashboardSectionHeading {
    color: #30241e;
    font-size: 12px;
    font-weight: 950;
    padding: 0 0 8px 0;
    border-bottom: 1px solid #e7dfd8;
}
QLabel#dashboardInfoLine { color: #332720; font-size: 13px; font-weight: 750; padding: 3px 0; }
QFrame#progressCircle {
    background: #fffdfb;
    border: 10px solid #eee5de;
    border-radius: 72px;
    min-width: 125px;
    max-width: 125px;
    min-height: 125px;
    max-height: 125px;
}
QLabel#dashboardPercent { color: #231812; font-size: 28px; font-weight: 950; }
QLabel#progressDone { color: #5e4c42; font-size: 11px; font-weight: 800; }
QLabel#dashboardProgressText { color: #44362e; font-size: 12px; font-weight: 650; line-height: 1.3; }
QLabel#dashboardActivity {
    color: #392c25;
    background: transparent;
    padding: 5px 2px 8px 2px;
    border-bottom: 1px solid #eee7e1;
    font-size: 11px;
    font-weight: 700;
}
QPushButton#secondaryButton {
    background: #fffdfb;
    color: #4f3a2f;
    border: 1px solid #d9cec5;
    border-radius: 7px;
    padding: 7px 10px;
    font-weight: 750;
}
QPushButton#dashboardQuickCard {
    min-height: 72px;
    background: #fffdfb;
    color: #30241e;
    border: 1px solid #ded5ce;
    border-radius: 9px;
    padding: 10px 12px;
    text-align: left;
    font-size: 11px;
    font-weight: 750;
}
QPushButton#dashboardQuickCard:hover { background: #faf3ed; border-color: #b97a51; }

/* MSTTS 11 Alpha 7: fokussierte Turnieroptionen */
QFrame#optionCategoryPanel {
    background: #f4ece6;
    border: 1px solid #dfd2c8;
    border-radius: 10px;
    min-width: 155px;
    max-width: 175px;
}
QPushButton#optionCategoryButton {
    background: transparent;
    color: #58443a;
    border: 0;
    border-radius: 8px;
    padding: 9px 12px;
    text-align: left;
    font-weight: 750;
}
QPushButton#optionCategoryButton:hover {
    background: #eadbd0;
}
QPushButton#optionCategoryButton:checked {
    background: #7a4a32;
    color: #fffaf5;
}
QStackedWidget#optionStack {
    background: #fffdfb;
    border: 1px solid #e1d7cf;
    border-radius: 10px;
}

/* MSTTS 12.1 - einheitliches UI-Fundament
   Dieser Abschlussblock ist bewusst autoritativ und vereinheitlicht die
   historisch gewachsenen Einzelstile, ohne die Turnierlogik zu verändern. */
QMainWindow, QWidget {
    background: #F3EEE8;
    color: #2F241E;
    font-family: "Avenir Next", "SF Pro Text", "Helvetica Neue", Arial;
    font-size: 13px;
}

QWidget#mainContent {
    background: #F3EEE8;
}

QFrame#sectionHeader {
    background: transparent;
    border: none;
}
QLabel#pageTitle {
    color: #2B201A;
    font-size: 25px;
    font-weight: 900;
    padding: 0;
}
QLabel#pageSubtitle {
    color: #7B6A5F;
    font-size: 13px;
    font-weight: 500;
    padding: 0;
}
QFrame#pageHeaderDivider {
    background: #DED4CA;
    color: #DED4CA;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QFrame#surfaceCard,
QFrame#sectionCard,
QFrame#statCard,
QFrame#workspaceCard,
QFrame#metricCard,
QFrame#documentCard,
QFrame#dashboardHero {
    background: #FFFDFC;
    border: 1px solid #DDD0C4;
    border-radius: 14px;
}
QLabel#cardHeading,
QLabel#sectionTitle,
QLabel#dashboardSectionHeading {
    color: #382820;
    font-size: 16px;
    font-weight: 850;
}
QLabel#cardDescription,
QLabel#sectionMeta,
QLabel#infoText {
    color: #7B6A5F;
    font-size: 12px;
}

QPushButton {
    min-height: 36px;
    padding: 8px 14px;
    border-radius: 9px;
    background: #FFFDFC;
    color: #5A4033;
    border: 1px solid #CFC0B4;
    font-size: 13px;
    font-weight: 750;
}
QPushButton:hover {
    background: #F8EFE8;
    border-color: #A934FF;
}
QPushButton:pressed {
    background: #EEDFD3;
}
QPushButton:disabled {
    background: #ECE7E2;
    color: #A3978E;
    border-color: #DDD4CC;
}
QPushButton#primaryButton,
QPushButton#actionTilePrimary,
QPushButton#launchCardPrimary {
    background: #6B432D;
    color: #FFFFFF;
    border: 1px solid #6B432D;
    font-weight: 850;
}
QPushButton#primaryButton:hover,
QPushButton#actionTilePrimary:hover,
QPushButton#launchCardPrimary:hover {
    background: #7C5037;
    border-color: #7C5037;
}
QPushButton#secondaryButton,
QPushButton#secondaryAction {
    background: #FFFDFC;
    color: #5A4033;
    border: 1px solid #BFA998;
    font-weight: 800;
}
QPushButton#secondaryButton:hover,
QPushButton#secondaryAction:hover {
    background: #F8EFE8;
    border-color: #8D2CFF;
}
QPushButton#dangerButton {
    background: #FFF8F7;
    color: #8E3733;
    border: 1px solid #C9827D;
    font-weight: 850;
}
QPushButton#dangerButton:hover {
    background: #FBE9E7;
    border-color: #9C433C;
}

QLineEdit, QComboBox, QListWidget, QTableWidget, QTableView,
QSpinBox, QTimeEdit, QTextEdit {
    background: #FFFDFC;
    color: #30251F;
    border: 1px solid #D3C5BA;
    border-radius: 8px;
    padding: 7px;
    selection-background-color: #A934FF;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QListWidget:focus,
QTableWidget:focus, QTableView:focus, QSpinBox:focus,
QTimeEdit:focus, QTextEdit:focus {
    border: 1px solid #8D2CFF;
}

QTableWidget, QTableView {
    background: #FFFDFC;
    alternate-background-color: #FAF6F2;
    gridline-color: #ECE3DC;
    border: 1px solid #D8CBC0;
    border-radius: 9px;
    padding: 0;
}
QTableWidget::item, QTableView::item {
    min-height: 34px;
    padding: 8px 10px;
    border-bottom: 1px solid #EEE6DF;
}
QTableWidget::item:hover, QTableView::item:hover {
    background: #F4E9E0;
}
QTableWidget::item:selected, QTableView::item:selected {
    background: #A934FF;
    color: #FFFFFF;
}
QHeaderView::section {
    background: #E9E0D7;
    color: #49362B;
    border: none;
    border-right: 1px solid #D8C8BB;
    border-bottom: 1px solid #CFC0B4;
    min-height: 36px;
    padding: 8px 10px;
    font-size: 12px;
    font-weight: 850;
}
QHeaderView::section:first {
    border-top-left-radius: 8px;
}
QHeaderView::section:last {
    border-top-right-radius: 8px;
    border-right: none;
}
QTableCornerButton::section {
    background: #E9E0D7;
    border: none;
    border-right: 1px solid #D8C8BB;
    border-bottom: 1px solid #CFC0B4;
}

QTabWidget::pane {
    background: #FFFDFC;
    border: 1px solid #DDD0C4;
    border-radius: 10px;
    top: -1px;
}
QTabBar::tab {
    min-height: 22px;
    padding: 9px 15px;
    margin-right: 3px;
    background: #EFE7E0;
    color: #716158;
    border: 1px solid #DDD0C4;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QTabBar::tab:selected {
    background: #FFFDFC;
    color: #6B432D;
    font-weight: 850;
    border-bottom: 2px solid #FFFDFC;
}

QDialog {
    background: #F3EEE8;
}
QDialogButtonBox QPushButton {
    min-width: 96px;
}
QGroupBox {
    background: #FFFDFC;
    border: 1px solid #DDD0C4;
    border-radius: 10px;
    margin-top: 12px;
    padding: 14px 10px 10px 10px;
    font-weight: 800;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #5A4033;
}

/* MSTTS 12.6: all workspace pages remain reachable on notebook screens. */
QScrollArea#pageScrollArea {
    background: transparent;
    border: none;
}
QScrollArea#pageScrollArea > QWidget > QWidget {
    background: transparent;
}
QScrollBar:vertical {
    width: 12px;
    margin: 2px;
    background: transparent;
}
QScrollBar::handle:vertical {
    min-height: 34px;
    border-radius: 5px;
    background: #CDB8A7;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    height: 12px;
    margin: 2px;
    background: transparent;
}
QScrollBar::handle:horizontal {
    min-width: 34px;
    border-radius: 5px;
    background: #CDB8A7;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}


/* MSTTS 12.7: modern workspace tabs and player assignment controls. */
QTabWidget#tournamentWorkspaceTabs::pane {
    background: transparent;
    border: none;
    border-top: 1px solid #DED0C5;
    border-radius: 0;
    top: -1px;
}
QTabWidget#tournamentWorkspaceTabs QTabBar::tab {
    min-height: 38px;
    padding: 11px 22px;
    margin: 0 5px 0 0;
    background: #F5ECE4;
    color: #805D47;
    border: 1px solid #DDCBBB;
    border-bottom: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    font-size: 14px;
    font-weight: 650;
}
QTabWidget#tournamentWorkspaceTabs QTabBar::tab:hover {
    background: #FBF5F0;
    color: #75462F;
    border-color: #B98560;
}
QTabWidget#tournamentWorkspaceTabs QTabBar::tab:selected {
    background: #A934FF;
    color: #FFFFFF;
    border-color: #A934FF;
    font-weight: 850;
}
QTabWidget#tournamentWorkspaceTabs QTabBar::tab:!selected {
    margin-top: 4px;
}
QLabel#listPanelHeading {
    color: #3B2B23;
    background: #F8F2ED;
    border: 1px solid #E6D9CE;
    border-radius: 9px;
    padding: 9px 11px;
    font-size: 12px;
    font-weight: 800;
}
QPushButton#assignmentArrowButton {
    min-width: 52px;
    max-width: 52px;
    min-height: 48px;
    max-height: 48px;
    padding: 0;
    background: #FFFDFC;
    color: #A934FF;
    border: 1px solid #D7C4B5;
    border-radius: 11px;
    font-size: 24px;
    font-weight: 650;
}
QPushButton#assignmentArrowButton:hover {
    background: #A934FF;
    color: #FFFFFF;
    border-color: #A934FF;
}
QPushButton#assignmentArrowButton:pressed {
    background: #8E5532;
    color: #FFFFFF;
}
QFrame#workspaceCard QListWidget {
    background: #FFFDFC;
    border: 1px solid #DED1C6;
    border-radius: 11px;
    padding: 5px;
}
QFrame#workspaceCard QListWidget::item {
    min-height: 34px;
    padding: 8px 10px;
    margin: 2px 0;
    border-radius: 7px;
    border-bottom: 1px solid #F0E7E0;
}
QFrame#workspaceCard QListWidget::item:hover {
    background: #F8EFE8;
}
QFrame#workspaceCard QListWidget::item:selected {
    background: #A934FF;
    color: #FFFFFF;
}


/* MSTTS 12.8 – kompakte Produktmarke oben, Entwicklersignatur unten */
QLabel#brandLogo {
    background: transparent;
    border: none;
    min-height: 94px;
    max-height: 100px;
    padding: 0;
}
QLabel#sidebarProductName {
    color: #fff9f4;
    background: transparent;
    border: none;
    font-size: 23px;
    font-weight: 950;
    letter-spacing: 1px;
    padding: 0 2px 1px 2px;
}
QLabel#sidebarProductSubtitle {
    color: #d8c8bd;
    background: transparent;
    border: none;
    font-size: 9px;
    font-weight: 650;
    padding: 0 4px 4px 4px;
}
QFrame#sidebarSignature {
    background: #f6eee8;
    border: 1px solid #d8c4b5;
    border-radius: 8px;
}
QLabel#sidebarSignatureTitle {
    color: #6f3b22;
    background: transparent;
    border: none;
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 0.6px;
}
QLabel#sidebarSignatureLine {
    color: #a65c2a;
    background: transparent;
    border: none;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.5px;
}
QLabel#sidebarVersion {
    color: #755d4f;
    background: transparent;
    border: none;
    font-size: 7px;
    font-weight: 700;
    padding-top: 4px;
}

/* MSTTS 12.9 – moderne, responsive Kennzahlenkarten auf dem Dashboard */
QFrame#dashboardStatCard {
    background: #fffdfb;
    border: 1px solid #ddd0c4;
    border-radius: 14px;
}
QFrame#dashboardStatCard:hover {
    background: #faf3ed;
    border-color: #b97a51;
}
QLabel#dashboardStatIcon {
    background: rgba(166, 92, 42, 0.11);
    color: #a65c2a;
    border: 1px solid rgba(166, 92, 42, 0.20);
    border-radius: 12px;
    font-size: 19px;
    font-weight: 900;
}
QLabel#dashboardStatValue {
    color: #271b15;
    font-size: 22px;
    font-weight: 950;
}
QLabel#dashboardStatLabel {
    color: #75645a;
    font-size: 12px;
    font-weight: 700;
}

/* MSTTS 13.0: kompakter professioneller Arbeitskopf */
QFrame#workspaceHeader {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid #ded7cf;
    border-radius: 10px;
}
QPushButton#sidebarToggle {
    font-size: 19px;
    font-weight: 700;
    padding: 0;
    border-radius: 8px;
}
QLabel#workspaceTitle {
    font-size: 18px;
    font-weight: 800;
}
QLabel#workspaceSubtitle {
    color: #716a64;
    font-size: 11px;
}
QLabel#workspaceStatus {
    color: #716a64;
    font-size: 10px;
    padding: 4px 8px;
    border: 1px solid #ded7cf;
    border-radius: 8px;
}

/* MSTTS 13.0 Alpha 5 – kompakter Leitstand */
QFrame#liveMetricCard { background: #fffdfa; border: 1px solid #ded4ca; border-radius: 9px; }
QLabel#liveMetricTitle { color: #8a6b58; font-size: 10px; font-weight: 800; }
QLabel#liveMetricValue { color: #442d20; font-size: 16px; font-weight: 850; }
QFrame#liveTableCard { min-height: 155px; padding: 6px; }

/* MSTTS 13.0 Alpha 9: context-sensitive dashboard command center */
QFrame#dashboardNextAction {
    background: #fff8f1;
    border: 1px solid #d9b08c;
    border-left: 5px solid #a65c2a;
    border-radius: 12px;
}
QLabel#dashboardNextActionBadge { color: #8a4a22; font-size: 10px; font-weight: 900; letter-spacing: 1px; }
QLabel#dashboardNextActionTitle { color: #3e2416; font-size: 18px; font-weight: 900; }
QLabel#dashboardNextActionMessage { color: #6b5548; font-size: 12px; }
QPushButton#dashboardNextActionButton {
    min-height: 42px; padding: 7px 16px; border-radius: 9px;
    background: #a65c2a; color: white; border: 1px solid #a65c2a; font-weight: 900;
}
QPushButton#dashboardNextActionButton:hover { background: #b96a35; }

/* MSTTS 13.0 Alpha 10 – automatische Turnierprüfung */
QFrame#dashboardHealthPanel {
    background: #f7fbf7;
    border: 1px solid #cfe1d2;
    border-radius: 11px;
}
QFrame#dashboardHealthPanel[state="warning"] { background: #fff8eb; border-color: #e5c680; }
QFrame#dashboardHealthPanel[state="error"] { background: #fff1ef; border-color: #dc9d94; }
QLabel#dashboardHealthIcon {
    background: #e2efe4;
    color: #356b40;
    border-radius: 17px;
    font-size: 18px;
    font-weight: 900;
}
QFrame#dashboardHealthPanel[state="warning"] QLabel#dashboardHealthIcon { background: #f7e5b9; color: #8a5b10; }
QFrame#dashboardHealthPanel[state="error"] QLabel#dashboardHealthIcon { background: #f2cec9; color: #9d352a; }
QLabel#dashboardHealthTitle { color: #4d3628; font-size: 10px; font-weight: 900; letter-spacing: 0.8px; }
QLabel#dashboardHealthMessage { color: #5f5148; font-size: 12px; }
QLabel#dashboardHealthDetails { color: #7a675a; font-size: 11px; font-weight: 700; }

/* Alpha 12: clearer navigation hierarchy */
QLabel#navSectionLabel {
    color: #7A6B60;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.7px;
    padding: 6px 8px 2px 8px;
}
QPushButton#navButton { min-height: 34px; text-align: left; padding-left: 12px; }
QFrame#workspaceHeader { min-height: 46px; }

/* MSTTS 13.0 Alpha 13 – Professional UI
   Ruhiger, flacher und konsistenter: Akzentfarbe nur fuer aktive/primäre Aktionen. */
QMainWindow, QWidget#appShell, QWidget#mainContent, QScrollArea, QWidget#dashboardContent {
    background: #F5F3F0;
    color: #292623;
}
QFrame#sidebar {
    background: #201D1B;
    border-right: 1px solid #302B28;
}
QLabel#navSectionLabel {
    color: #8F8781;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.1px;
    padding: 10px 12px 3px 12px;
}
QPushButton#navButton {
    background: transparent;
    color: #D8D2CE;
    border: none;
    border-radius: 7px;
    min-height: 32px;
    padding: 7px 11px;
    text-align: left;
    font-size: 12px;
    font-weight: 650;
}
QPushButton#navButton:hover { background: #2B2724; color: #FFFFFF; }
QPushButton#navButton:checked {
    background: #F4EEE9;
    color: #4B3023;
    font-weight: 850;
}
QFrame#workspaceHeader {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E3DFDB;
    border-radius: 0;
    min-height: 48px;
}
QLabel#workspaceTitle { color: #272421; font-size: 19px; font-weight: 850; }
QLabel#workspaceSubtitle { color: #7D7772; font-size: 11px; }
QLabel#workspaceStatus {
    background: #F7F5F3;
    color: #68615C;
    border: 1px solid #E3DFDB;
    border-radius: 12px;
    padding: 4px 9px;
}
QFrame#progressHeader {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E1DD;
    border-radius: 0;
}
QPushButton#progressStep {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #77706A;
    min-height: 30px;
    padding: 5px 10px;
}
QPushButton#progressStep[active="true"] { background: #F4EEE9; color: #674532; border: none; }
QPushButton#progressStep[current="true"] { background: #6B4633; color: #FFFFFF; border: none; }
QFrame#dashboardHero, QFrame#sectionCard, QFrame#surfaceCard, QFrame#workspaceCard,
QFrame#dashboardStatCard, QFrame#metricCard, QFrame#liveMetricCard, QFrame#liveTableCard {
    background: #FFFFFF;
    border: 1px solid #E2DEDA;
    border-radius: 10px;
}
QFrame#dashboardStatCard:hover, QFrame#metricCard:hover { border-color: #C9B8AC; background: #FFFFFF; }
QLabel#dashboardTitle, QLabel#pageTitle { color: #262320; font-size: 25px; font-weight: 850; }
QLabel#sectionTitle { color: #302C29; font-size: 16px; font-weight: 850; }
QLabel#cardHeading { color: #37312D; font-size: 13px; font-weight: 800; }
QLabel#dashboardStatValue, QLabel#metricValue { color: #302A26; font-size: 23px; font-weight: 900; }
QLabel#dashboardStatIcon, QLabel#statIcon {
    background: #F5F0EC;
    color: #76503B;
    border: none;
    border-radius: 9px;
}
QPushButton {
    background: #FFFFFF;
    color: #413A35;
    border: 1px solid #D8D2CD;
    border-radius: 7px;
    padding: 7px 11px;
    font-weight: 700;
}
QPushButton:hover { background: #F7F4F1; border-color: #BFB5AE; }
QPushButton:pressed { background: #EEE9E5; }
QPushButton#primaryButton, QPushButton#primaryAction, QPushButton#dashboardNextActionButton,
QPushButton#actionTilePrimary, QPushButton#launchCardPrimary {
    background: #6B4633;
    color: #FFFFFF;
    border: 1px solid #6B4633;
    border-radius: 7px;
    font-weight: 850;
}
QPushButton#primaryButton:hover, QPushButton#primaryAction:hover, QPushButton#dashboardNextActionButton:hover,
QPushButton#actionTilePrimary:hover, QPushButton#launchCardPrimary:hover { background: #7B523C; border-color: #7B523C; }
QLineEdit, QComboBox, QListWidget, QTableWidget, QSpinBox, QTimeEdit, QTextEdit {
    background: #FFFFFF;
    border: 1px solid #DCD7D2;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #76503B;
}
QLineEdit:focus, QComboBox:focus, QListWidget:focus, QTableWidget:focus,
QSpinBox:focus, QTimeEdit:focus, QTextEdit:focus { border: 1px solid #8A6651; }
QTableWidget { gridline-color: #EEEAE7; alternate-background-color: #FAF9F8; }
QHeaderView::section {
    background: #F4F2F0;
    color: #5A534E;
    border: none;
    border-bottom: 1px solid #DDD8D4;
    padding: 7px 9px;
    font-size: 11px;
    font-weight: 800;
}
QTableWidget::item { padding: 5px 7px; border-bottom: 1px solid #F0EDEA; }
QTableWidget::item:selected { background: #EEE5DF; color: #332820; }
QTabWidget::pane { background: #FFFFFF; border: 1px solid #E2DEDA; border-radius: 8px; }
QTabBar::tab {
    background: transparent;
    border: none;
    color: #77706A;
    padding: 8px 13px;
    margin-right: 2px;
}
QTabBar::tab:selected { color: #5F3E2E; font-weight: 850; border-bottom: 2px solid #6B4633; }
QStatusBar { background: #FFFFFF; border-top: 1px solid #E3DFDB; color: #77706A; }
QFrame#dashboardNextAction { background: #FFFFFF; border: 1px solid #DCCFC6; border-left: 3px solid #6B4633; border-radius: 9px; }
QFrame#dashboardHealthPanel { border-radius: 9px; }
QScrollBar:vertical { background: transparent; width: 9px; }
QScrollBar::handle:vertical { background: #C8C1BC; min-height: 30px; border-radius: 4px; }
QScrollBar:horizontal { background: transparent; height: 9px; }
QScrollBar::handle:horizontal { background: #C8C1BC; min-width: 30px; border-radius: 4px; }

/* Alpha 14 – information hierarchy */
QFrame#dashboardNextAction { border: 1px solid #DCCFC3; border-radius: 12px; background: #FCFAF7; }
QPushButton#dashboardAction, QPushButton#dashboardActionPrimary { text-align: left; padding: 8px 12px; border-radius: 8px; }
QFrame#dashboardStatCard { border-radius: 10px; }
QFrame#dashboardPanel { border: 1px solid #E7DED5; border-radius: 10px; }
QLabel#dashboardSectionHeading { font-size: 11px; letter-spacing: 0.6px; }
QFrame#liveMetricCard { border-radius: 9px; }
QFrame#liveSummaryCard { border-radius: 10px; }

/* Alpha 15: Professional command layout */
QFrame#dashboardManagementBar { background: #FBF8F5; border: 1px solid #E6DDD5; border-radius: 10px; }
QLabel#dashboardManagementTitle { color: #76685D; font-size: 10px; font-weight: 800; letter-spacing: 1px; }
QFrame#dashboardNextAction { border-radius: 12px; }
QFrame#dashboardPanel { border: 1px solid #E9E2DC; border-radius: 10px; }
QPushButton#dangerButton { background: transparent; color: #A3463F; border: 1px solid #D8B5B1; }
QPushButton#dangerButton:hover { background: #FAF0EF; }
\n/* Startfix 3: flatter professional workspace */\nQLabel#sectionEyebrow { color: #75685f; font-size: 10px; font-weight: 800; letter-spacing: 0.8px; padding-top: 6px; }\nQFrame#wizardCheckCard { background: transparent; border: none; }\nQPushButton[wizardStep="true"] { background: #fbfaf8; border: 1px solid #e2ddd8; border-radius: 7px; padding: 6px 10px; font-weight: 600; }\nQPushButton[wizardStep="true"]:hover { background: #f4eee8; border-color: #cdb8a8; }\nQFrame#liveSummaryCard { background: transparent; border: none; }\nQFrame#liveMetricCell { background: transparent; border: none; border-right: 1px solid #e8e1db; }\nQFrame#liveMetricCell:last-child { border-right: none; }\nQLabel#liveMetricTitle { color: #81756c; font-size: 9px; font-weight: 800; letter-spacing: 0.6px; }\nQLabel#liveMetricValue { font-size: 15px; font-weight: 700; }\n
/* Startfix 4: professional phase workspace */
QFrame#phaseCommandBar { background: #FBF9F7; border: 1px solid #E8E0D9; border-radius: 10px; }
QFrame#workspaceSection { background: #FFFFFF; border: none; border-radius: 0px; }
QLabel#fieldCaption, QLabel#sectionCaption { color: #766A61; font-size: 10px; font-weight: 800; letter-spacing: 0.8px; }
QTabWidget#tournamentWorkspaceTabs::pane { border: none; border-top: 1px solid #E4DDD6; top: -1px; background: #FFFFFF; }
QTabWidget#tournamentWorkspaceTabs QTabBar::tab { background: transparent; border: none; border-bottom: 2px solid transparent; padding: 10px 16px; margin-right: 6px; }
QTabWidget#tournamentWorkspaceTabs QTabBar::tab:selected { color: #6F4028; border-bottom: 2px solid #A934FF; font-weight: 700; }
QTabWidget#tournamentWorkspaceTabs QTabBar::tab:hover { background: #F7F2EE; }
QFrame#optionCategoryPanel { border: none; background: #F8F5F2; border-radius: 8px; }

/* Startfix 6: reduced professional dashboard */
QFrame#dashboardStatusStrip { background: transparent; border: none; border-bottom: 1px solid #E8E2DD; }
QLabel#dashboardStatusItem { color: #655D57; font-size: 11px; font-weight: 700; padding: 4px 10px 8px 0; }
QPushButton#dashboardQuickCard { background: transparent; border: 1px solid #E3DDD8; border-radius: 8px; text-align: left; padding: 8px 11px; font-weight: 700; }
QPushButton#dashboardQuickCard:hover { background: #F8F5F2; border-color: #CDBEB3; }
QFrame#dashboardManagementBar { background: transparent; border: none; border-top: 1px solid #E8E2DD; border-bottom: 1px solid #E8E2DD; border-radius: 0; }
QFrame#dashboardNextAction { background: #FBF8F5; border: 1px solid #DED2C8; border-left: 3px solid #6B4633; border-radius: 10px; }

/* Startfix 7: professional participant workspace */
QFrame#participantToolbar { background: #FAF8F6; border: 1px solid #E5DFDA; border-radius: 9px; }
QListWidget#participantList { background: #FFFFFF; border: 1px solid #E6E1DD; border-radius: 9px; padding: 3px; outline: none; }
QListWidget#participantList::item { border-bottom: 1px solid #F0ECE9; padding: 7px 9px; }
QListWidget#participantList::item:selected { background: #F1E8E1; color: #332820; border-radius: 5px; }
QLabel#participantCount { color: #6E655F; font-size: 11px; font-weight: 700; }
QLabel#pageTitle { font-size: 22px; font-weight: 700; color: #2F2925; }
QLabel#pageSubtitle, QLabel#mutedLabel { color: #776F69; font-size: 11px; }

/* Startfix 8: live operation first */
QFrame#liveStatusStrip { background: transparent; border: none; border-bottom: 1px solid #E7E0DA; }
QLabel#liveStatusItem { color: #665D56; font-size: 11px; font-weight: 650; padding-right: 8px; }
QLabel#liveProgressLabel { color: #766D66; font-size: 10px; font-weight: 700; }
QLabel#liveSectionTitle { color: #403933; font-size: 13px; font-weight: 800; padding-bottom: 2px; }
QFrame#liveTableCard { background: #FFFDFC; border: 1px solid #D8CEC5; border-radius: 10px; padding: 7px; }
QFrame#liveSummaryCard { background: transparent; border: 1px solid #E7E0DA; border-radius: 8px; }
QFrame#flowWarnings { border-radius: 8px; }

/* Startfix 9: professional standings and knockout workspace */
QLabel#phaseStatusPill {
    background: #F5F1ED;
    border: 1px solid #E2D9D2;
    border-radius: 9px;
    padding: 5px 10px;
    color: #5F554E;
    font-size: 11px;
    font-weight: 700;
}
QLabel#finalRoundBanner {
    background: #FBF8F5;
    border: none;
    border-left: 3px solid #8A583A;
    padding: 10px 12px;
    color: #4A4039;
    font-size: 12px;
    font-weight: 650;
}
QTableWidget#professionalMatchTable, QTableWidget#professionalStandingsTable {
    background: #FFFFFF;
    border: none;
    gridline-color: #EEE9E5;
    alternate-background-color: #FBFAF9;
}
QTableWidget#professionalMatchTable QHeaderView::section,
QTableWidget#professionalStandingsTable QHeaderView::section {
    background: #F7F4F1;
    color: #61564E;
    border: none;
    border-bottom: 1px solid #DDD5CF;
    padding: 8px 7px;
    font-size: 10px;
    font-weight: 800;
}
QTableWidget#professionalMatchTable::item, QTableWidget#professionalStandingsTable::item {
    padding: 7px 8px;
    border-bottom: 1px solid #F0ECE9;
}

/* Startfix 10: unified global workspace header */
QFrame#workspaceHeader { background: #FFFEFD; border: none; border-bottom: 1px solid #E7E0DA; border-radius: 0; min-height: 52px; }
QPushButton#workspaceBackButton { background: transparent; border: 1px solid #E0D8D2; border-radius: 7px; font-size: 21px; color: #554B45; padding: 0; }
QPushButton#workspaceBackButton:hover { background: #F7F3F0; }
QPushButton#workspaceBackButton:disabled { color: #C7C0BA; border-color: #EEE9E5; }
QLabel#workspaceTournament { color: #302A26; font-size: 11px; font-weight: 750; }
QLabel#workspaceStatus { color: #847970; font-size: 10px; font-weight: 650; }
QPushButton#workspacePrimaryAction { background: #5A3A2A; color: #FFFFFF; border: none; border-radius: 7px; padding: 7px 14px; font-weight: 750; }
QPushButton#workspacePrimaryAction:hover { background: #6B4633; }

/* Startfix 11: professional empty-state landing page */
QWidget#startPage { background: #F7F4F1; }
QFrame#startPageShell { background: #FFFFFF; border: 1px solid #E3DDD7; border-radius: 14px; max-width: 720px; }
QLabel#startEyebrow { color: #7C6A5E; font-size: 10px; font-weight: 800; letter-spacing: 1.4px; }
QLabel#startTitle { color: #2D2926; font-size: 28px; font-weight: 750; }
QLabel#startSectionTitle { color: #746960; font-size: 10px; font-weight: 800; letter-spacing: 1px; margin-top: 8px; }
QPushButton#startPrimaryButton { font-weight: 750; padding: 10px 18px; }
QPushButton#startSecondaryButton { background: #FFFFFF; color: #493B32; border: 1px solid #D5CBC3; padding: 10px 18px; }
QListWidget#recentTournamentList { background: #FFFFFF; border: 1px solid #E5DED8; border-radius: 9px; padding: 4px; outline: none; }
QListWidget#recentTournamentList::item { min-height: 34px; padding: 4px 8px; border-radius: 6px; }
QListWidget#recentTournamentList::item:selected { background: #EFE6DF; color: #2D2926; }
QLabel#startEmptyRecent { color: #8A817A; padding: 14px 0 18px 0; }
QLabel#startExamplesLabel { color: #9A918A; font-size: 10px; font-weight: 700; padding-right: 4px; }

/* Startfix 12: unified professional dialogs */
QDialog#professionalDialog { background: #FCFBFA; }
QDialog#professionalDialog QLabel { color: #3B342F; }
QDialog#professionalDialog QLabel#mutedText { color: #7D746D; font-size: 11px; }
QDialog#professionalDialog QLineEdit,
QDialog#professionalDialog QComboBox,
QDialog#professionalDialog QSpinBox,
QDialog#professionalDialog QTimeEdit,
QDialog#professionalDialog QTextEdit {
    background: #FFFFFF;
    border: 1px solid #DCD5CF;
    border-radius: 7px;
    padding: 7px 9px;
    selection-background-color: #E8DDD5;
}
QDialog#professionalDialog QLineEdit:focus,
QDialog#professionalDialog QComboBox:focus,
QDialog#professionalDialog QSpinBox:focus,
QDialog#professionalDialog QTextEdit:focus { border: 1px solid #8A624A; }
QDialog#professionalDialog QCheckBox { spacing: 8px; padding: 4px 0; }
QDialog#professionalDialog QDialogButtonBox { border-top: 1px solid #E8E2DD; padding-top: 12px; margin-top: 6px; }
QPushButton#dialogPrimaryButton { background: #5A3A2A; color: #FFFFFF; border: none; border-radius: 7px; padding: 8px 16px; font-weight: 750; min-width: 110px; }
QPushButton#dialogPrimaryButton:hover { background: #6B4633; }
QPushButton#dialogPrimaryButton:disabled { background: #CFC7C1; color: #F6F3F1; }
QPushButton#dialogSecondaryButton { background: #FFFFFF; color: #4C433D; border: 1px solid #D8D0CA; border-radius: 7px; padding: 8px 14px; min-width: 90px; }
QPushButton#dialogSecondaryButton:hover { background: #F7F3F0; }
QMessageBox { background: #FCFBFA; }
QMessageBox QLabel { color: #3B342F; min-width: 300px; }
QMessageBox QPushButton { min-width: 92px; padding: 7px 12px; border-radius: 7px; }

/* Startfix 13: global visual rhythm and final UI consistency */
QMainWindow, QWidget {
    font-size: 12px;
}
QLabel#pageTitle {
    font-size: 21px;
    font-weight: 750;
    color: #302A26;
}
QLabel#pageSubtitle, QLabel#mutedLabel, QLabel#mutedText {
    font-size: 11px;
    color: #7B736D;
}
QLabel#sectionTitle, QLabel#liveSectionTitle, QLabel#cardHeading {
    font-size: 13px;
    font-weight: 800;
    color: #403833;
}
QLabel#cardDescription {
    color: #7A716B;
    font-size: 11px;
}
QPushButton {
    min-height: 32px;
    border-radius: 7px;
    padding: 6px 11px;
    font-size: 12px;
    font-weight: 650;
}
QPushButton#primaryButton,
QPushButton#workspacePrimaryAction,
QPushButton#dialogPrimaryButton,
QPushButton#startPrimaryButton {
    min-height: 34px;
    font-weight: 750;
}
QPushButton#secondaryButton,
QPushButton#dialogSecondaryButton,
QPushButton#dangerButton {
    min-height: 32px;
}
QLineEdit, QComboBox, QSpinBox, QTimeEdit {
    min-height: 30px;
    border-radius: 7px;
    padding: 4px 8px;
    font-size: 12px;
}
QTextEdit, QListWidget, QTableWidget {
    border-radius: 8px;
}
QHeaderView::section {
    min-height: 30px;
    background: #F6F3F0;
    color: #625850;
    border: none;
    border-bottom: 1px solid #DED8D3;
    padding: 5px 8px;
    font-size: 10px;
    font-weight: 800;
}
QTableWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #F0ECE9;
}
QTableWidget::item:selected,
QListWidget::item:selected {
    background: #EFE6DF;
    color: #302A26;
}
QTabWidget::pane {
    border: none;
    border-top: 1px solid #E5DFDA;
    border-radius: 0;
    background: transparent;
}
QTabBar::tab {
    min-height: 28px;
    padding: 6px 11px;
    margin-right: 3px;
    font-size: 11px;
    font-weight: 650;
}
QTabBar::tab:selected {
    font-weight: 800;
}
QMenu {
    border-radius: 7px;
    padding: 5px;
}
QMenu::item {
    min-height: 26px;
    padding: 5px 22px 5px 10px;
    border-radius: 5px;
}
QToolTip {
    border-radius: 5px;
    padding: 5px 7px;
    font-size: 11px;
}
QScrollBar:vertical { width: 9px; }
QScrollBar:horizontal { height: 9px; }
QFrame#workspaceHeader {
    min-height: 50px;
}
QPushButton#navButton {
    min-height: 31px;
    padding: 7px 11px;
    border-radius: 7px;
    font-size: 12px;
}
QPushButton#progressStep {
    min-height: 28px;
    border-radius: 7px;
    padding: 5px 8px;
    font-size: 10px;
}
QProgressBar {
    min-height: 12px;
    max-height: 12px;
    border-radius: 6px;
    font-size: 9px;
}
QProgressBar::chunk { border-radius: 6px; }
QFrame#surfaceCard,
QFrame#sectionCard,
QFrame#liveSummaryCard,
QFrame#liveTableCard {
    border-radius: 9px;
}
QDialog#professionalDialog {
    font-size: 12px;
}
QStatusBar {
    min-height: 22px;
    font-size: 10px;
}

/* Startfix 14: guided end-to-end workflow */
QLabel#workflowRouteHint { color: #786B61; font-size: 10px; font-weight: 700; padding: 0 0 7px 0; }

/* Startfix 16: intelligent tournament wizard */
QLabel#wizardRecommendation { background: #F8F5F2; border: 1px solid #E2D8D0; border-radius: 8px; padding: 10px 12px; color: #51483F; font-weight: 700; }

/* Startfix 17: tournament setup review */
QLabel#wizardSummaryHeadline { background: #F8F5F2; border: 1px solid #DED3CB; border-radius: 10px; padding: 16px; color: #463D36; font-size: 16px; font-weight: 800; }
QLabel#wizardSummaryDetails { padding: 14px 4px; color: #5E554E; font-size: 12px; line-height: 1.5; }

/* Startfix 18: automatic group allocation preview */
QLabel#groupPreviewSummary {
    background: #F8F5F2;
    border: 1px solid #E2D8D0;
    border-radius: 8px;
    padding: 9px 12px;
    color: #51483F;
    font-weight: 700;
}
QFrame#groupPreviewCard {
    background: #FFFFFF;
    border: 1px solid #E7E0DA;
    border-radius: 9px;
}
QLabel#groupPreviewTitle { color: #4B4038; font-weight: 800; font-size: 12px; }
QLabel#groupPreviewPlayer { color: #615850; padding: 2px 0; }

/* Startfix 20: interactive group review */
QFrame#groupPreviewTools {
    background: #FAF8F6;
    border: 1px solid #E5DDD7;
    border-radius: 9px;
}
QListWidget#groupPreviewList {
    background: #FFFFFF;
    border: 1px solid #ECE5DF;
    border-radius: 7px;
    padding: 3px;
}
QListWidget#groupPreviewList::item {
    min-height: 26px;
    padding: 3px 6px;
    border-radius: 5px;
}
QListWidget#groupPreviewList::item:selected {
    background: #EEE6E0;
    color: #3F352F;
}

/* Startfix 21: drag & drop group review */
QListWidget#groupPreviewList {
    alternate-background-color: #FAF8F6;
}
QListWidget#groupPreviewList::item:hover {
    background: #F5F0EC;
}
QListWidget#groupPreviewList::item:selected {
    background: #E9DDD5;
    color: #342B26;
}

/* Startfix 22: fairness check in group preview */
QLabel#groupFairnessSummary, QLabel#groupFairnessOverallOk, QLabel#groupFairnessOverallWarning {
    border-radius: 8px;
    padding: 9px 11px;
    font-size: 11px;
    font-weight: 700;
}
QLabel#groupFairnessOverallOk { background: #F3F7F2; border: 1px solid #D8E4D5; color: #486046; }
QLabel#groupFairnessOverallWarning { background: #FFF8EC; border: 1px solid #EBD8B5; color: #775B2B; }
QLabel#groupFairnessOk { color: #657663; font-size: 10px; padding: 1px 0 4px 0; }
QLabel#groupFairnessWarning { color: #8A6428; font-size: 10px; font-weight: 700; padding: 1px 0 4px 0; }

/* Startfix 24: transparent group fairness ratings */
QLabel#groupRatingVeryGood,
QLabel#groupRatingGood,
QLabel#groupRatingCheck {
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: 800;
}
QLabel#groupRatingVeryGood {
    background: #EEF5EF;
    border: 1px solid #CADCCB;
    color: #3E6844;
}
QLabel#groupRatingGood {
    background: #F7F3E9;
    border: 1px solid #DED3B9;
    color: #735F31;
}
QLabel#groupRatingCheck {
    background: #FAEEEC;
    border: 1px solid #E3C4BE;
    color: #8A493F;
}
QLabel#groupRatingExplanation {
    color: #665D56;
    font-size: 10px;
}

/* Startfix 25: compact tournament start preflight */
QLabel#startCheckSummary {
    background: #F8F5F2;
    border: 1px solid #DED4CC;
    border-radius: 9px;
    padding: 11px 13px;
    color: #493F38;
    font-size: 13px;
    font-weight: 800;
}
QLabel#startCheckRoute {
    color: #645950;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 1px;
}
QFrame#startCheckPanel {
    background: #FFFFFF;
    border: 1px solid #E6DFD9;
    border-radius: 9px;
}
QLabel#startCheckOk { color: #46684A; font-weight: 700; }
QLabel#startCheckWarning { color: #7C6232; }
QLabel#startCheckBlocker { color: #994B43; font-weight: 700; }
QLabel#startCheckReady {
    background: #EEF5EF;
    border: 1px solid #CADCCB;
    border-radius: 7px;
    padding: 8px 10px;
    color: #3E6844;
    font-weight: 700;
}
QLabel#startCheckNotice {
    background: #F7F3E9;
    border: 1px solid #DED3B9;
    border-radius: 7px;
    padding: 8px 10px;
    color: #735F31;
}
QLabel#startCheckBlocked {
    background: #FAEEEC;
    border: 1px solid #E3C4BE;
    border-radius: 7px;
    padding: 8px 10px;
    color: #8A493F;
    font-weight: 700;
}

/* Startfix 30: compact professional workflow shortcuts */
QFrame#workflowQuickActions { background: transparent; border: none; }
QPushButton#workflowQuickButton { background: #F5EEE8; color: #604636; border: 1px solid #DDCFC4; border-radius: 7px; padding: 7px 9px; font-size: 11px; font-weight: 700; }
QPushButton#workflowQuickButton:hover { background: #EADDD3; border-color: #CDB8A8; }

/* Startfix 31: visible workflow readiness */
QPushButton#workflowQuickButton[state="done"] {
    background: #EEF5EF;
    border-color: #CADCCB;
    color: #3E6844;
}
QPushButton#workflowQuickButton[state="current"] {
    background: #6F4123;
    border-color: #6F4123;
    color: #FFFFFF;
}
QPushButton#workflowQuickButton[state="upcoming"] {
    background: #F7F3EF;
    border-color: #E4DAD2;
    color: #786B62;
}


/* Startfix 32: calmer professional workflow header */
QFrame#workspaceHeader { min-height: 46px; max-height: 54px; }
QFrame#workflowQuickActions { background: transparent; }
QLabel#workflowStatusCompact {
    padding: 5px 9px;
    border: 1px solid #dfcdbd;
    border-radius: 9px;
    background: #fbf7f2;
    font-size: 10px;
    font-weight: 700;
}
QPushButton#workflowQuickButton { min-height: 30px; padding: 4px 9px; }
QPushButton#workflowQuickButton[state="done"] { font-weight: 600; }
QPushButton#workflowQuickButton[state="upcoming"] { background: #f8f4ef; }
QLabel#workspaceTournament { font-size: 11px; font-weight: 700; }

/* Startfix 33: tournament-day operator focus */
QFrame#liveOperatorFocus {
    border: 1px solid #dbc3ae;
    border-radius: 10px;
    background: #fbf7f2;
}
QFrame#liveOperatorFocus[state="attention"] { border-width: 2px; }
QFrame#liveOperatorFocus[state="running"] { background: #f7f1ea; }
QFrame#liveOperatorFocus[state="ready"] { background: #faf6f1; }
QFrame#liveOperatorFocus[state="done"] { background: #f5f4f1; }
QLabel#liveOperatorFocusTitle { font-size: 15px; font-weight: 800; }
QPushButton#liveOperatorFocusAction { min-width: 150px; font-weight: 750; }
QFrame#liveTableCard[matchState="running"] { border-width: 2px; }
QFrame#liveTableCard[matchState="result_pending"] { border-width: 2px; }
QFrame#liveTableCard[matchState="free"] { background: #faf8f5; }


/* Startfix 35: distinguish current workspace from recommended next step */
QPushButton#workflowQuickButton[state="active"] {
    background: #6F4123;
    border-color: #6F4123;
    color: #FFFFFF;
    font-weight: 800;
}
QPushButton#workflowQuickButton[state="recommended"] {
    background: #FBF4EC;
    border-color: #CFAF95;
    color: #6F4123;
    font-weight: 700;
}

/* Startfix 36: responsive two-row workspace header */
QFrame#workspaceHeader {
    min-height: 82px;
    max-height: 92px;
}
QFrame#workflowQuickActions { min-height: 32px; }
QLabel#workflowStatusCompact {
    padding: 4px 8px;
    border-radius: 8px;
}
QPushButton#workflowQuickButton {
    min-height: 30px;
    padding-left: 8px;
    padding-right: 8px;
}
QPushButton#workspacePrimaryAction {
    padding-left: 10px;
    padding-right: 10px;
}


/* Startfix 37: one dominant primary action per workspace */
QPushButton#participantAddButton {
    background: #FBF7F2;
    color: #6F4123;
    border: 1px solid #CFAF95;
    border-radius: 7px;
    padding: 7px 12px;
    font-weight: 750;
}
QPushButton#participantAddButton:hover {
    background: #F4E8DC;
    border-color: #B98C67;
}


/* Startfix 38: compact workspace without sacrificing readability */
QFrame#progressHeader { min-height: 72px; max-height: 82px; }
QLabel#progressTitle { padding-top: 0; padding-bottom: 0; }
QPushButton#progressStep { min-height: 30px; padding-top: 4px; padding-bottom: 4px; }
QFrame#workspaceHeader { margin-bottom: 0; }

/* Startfix 39: dashboard final polish - keep work areas visible on notebook screens */
QPushButton#dashboardQuickCard {
    min-height: 46px;
    max-height: 52px;
    padding: 6px 10px;
}


/* STARTFIX 50 – Professional Design Pass */
QWidget#mainContent { background: #F4F0EC; }
QFrame#progressHeader, QFrame#surfaceCard, QFrame#workspaceCard, QFrame#sectionCard, QFrame#statCard { background: #FFFEFC; border: 1px solid #DED6CF; border-radius: 12px; }
QPushButton { border-radius: 8px; padding: 9px 14px; }
QPushButton#primaryButton { background: #81502F; border-color: #81502F; }
QPushButton#primaryButton:hover { background: #925F3B; border-color: #925F3B; }
QLineEdit, QComboBox, QListWidget, QTableWidget, QSpinBox, QTimeEdit, QTextEdit { background: #FFFFFF; border: 1px solid #D8CEC6; border-radius: 7px; padding: 7px; }
QHeaderView::section { background: #F1EBE6; color: #49372D; border-right: 1px solid #DED6CF; border-bottom: 1px solid #D8CEC6; padding: 8px 10px; }
QTableWidget { background: #FFFFFF; alternate-background-color: #FBF8F5; gridline-color: #E9E2DC; }
QTabBar::tab { padding: 9px 16px; }
QLabel#dashboardTitle { color:#30231C; font-size:26px; font-weight:850; }
QLabel#sectionTitle, QLabel#cardHeading { color:#392A22; }
QStatusBar { background:#FFFEFC; border-top:1px solid #DED6CF; }

/* Startfix 65: professional table design globally applied */
QTableWidget {
    background: #FFFFFF;
    color: #302A26;
    border: none;
    border-radius: 0px;
    gridline-color: #EEE9E5;
    alternate-background-color: #FBFAF9;
    selection-background-color: #EADFD7;
    selection-color: #3F3028;
    outline: none;
}
QTableWidget QHeaderView::section {
    background: #F7F4F1;
    color: #61564E;
    border: none;
    border-right: 1px solid #EEE9E5;
    border-bottom: 1px solid #DDD5CF;
    padding: 8px 7px;
    font-size: 10px;
    font-weight: 800;
}
QTableWidget::item {
    padding: 7px 8px;
    border: none;
    border-bottom: 1px solid #F0ECE9;
}
QTableWidget::item:selected { background: #EADFD7; color: #3F3028; }
QTableWidget QTableCornerButton::section { background: #F7F4F1; border: none; border-bottom: 1px solid #DDD5CF; }

/* STARTFIX 90 – Professional UI polish
   A calmer, more premium visual system without changing any workflows. */
QMainWindow, QWidget {
    background: #F2EEE9;
    color: #2D241F;
    font-family: "Avenir Next", "SF Pro Text", "Helvetica Neue", Arial;
    font-size: 13px;
}
QWidget#mainContent, QWidget#dashboardContent { background: #F2EEE9; }

/* Sidebar: clearer hierarchy and a stronger active state */
QFrame#sidebar { background: #201711; border: none; }
QLabel#navSection {
    color: #A89588;
    background: transparent;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.2px;
    padding: 5px 12px 4px 12px;
}
QPushButton#navButton {
    background: transparent;
    color: #E9DED6;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 10px 12px;
    text-align: left;
    font-weight: 650;
}
QPushButton#navButton:hover {
    background: #30231D;
    color: #FFFFFF;
    border-color: #3B2B23;
}
QPushButton#navButton:checked {
    background: #F7F1EB;
    color: #3A271D;
    border: 1px solid #E8D9CD;
    font-weight: 850;
}
QFrame#navDivider { background: #49362C; color: #49362C; max-height: 1px; border: none; }

/* Workspace header */
QFrame#workspaceHeader {
    background: #FBF8F4;
    border: 1px solid #E4DAD2;
    border-radius: 12px;
    min-height: 76px;
    max-height: 88px;
}
QLabel#pageTitle {
    color: #2B211C;
    font-size: 24px;
    font-weight: 850;
}
QLabel#pageSubtitle, QLabel#mutedLabel, QLabel#mutedText {
    color: #7A6C62;
    font-size: 11px;
}
QPushButton#workspacePrimaryAction {
    background: #74472E;
    color: #FFFFFF;
    border: 1px solid #74472E;
    border-radius: 9px;
    padding: 9px 14px;
    font-weight: 800;
}
QPushButton#workspacePrimaryAction:hover { background: #865638; border-color: #865638; }

/* Tournament progress: lighter rail, stronger current step */
QFrame#progressHeader {
    background: #FBF8F4;
    border: 1px solid #E4DAD2;
    border-radius: 12px;
    min-height: 72px;
    max-height: 82px;
}
QLabel#progressTitle { color: #5A4335; font-size: 10px; font-weight: 900; letter-spacing: 1.2px; }
QPushButton#progressStep {
    background: transparent;
    color: #746960;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 9px;
    font-size: 11px;
    font-weight: 700;
}
QPushButton#progressStep:hover { background: #F1E8E0; color: #5D3B29; }
QPushButton#progressStep[active="true"] { background: #F2E7DD; color: #71472F; border-color: #E1CDBC; }
QPushButton#progressStep[current="true"] { background: #74472E; color: #FFFFFF; border-color: #74472E; font-weight: 850; }

/* Cards and panels */
QFrame#surfaceCard, QFrame#sectionCard, QFrame#statCard, QFrame#workspaceCard,
QFrame#workspaceSection, QFrame#card, QFrame#uiCard, QFrame#dashboardPanel,
QFrame#dashboardNextAction, QFrame#dashboardHealthPanel, QFrame#dashboardManagementBar {
    background: #FFFEFC;
    border: 1px solid #E2D9D2;
    border-radius: 12px;
}
QLabel#cardHeading, QLabel#sectionTitle, QLabel#cardTitle, QLabel#dashboardSectionHeading {
    color: #332720;
    font-weight: 850;
}
QLabel#cardDescription, QLabel#cardSubtitle, QLabel#sectionMeta { color: #7C6F66; }

/* Buttons: restrained, clear action hierarchy */
QPushButton {
    background: #FFFEFC;
    color: #5A3B2B;
    border: 1px solid #D7C8BC;
    border-radius: 8px;
    padding: 8px 13px;
    font-weight: 700;
}
QPushButton:hover { background: #F8F0E9; border-color: #B9957D; }
QPushButton:pressed { background: #EFE1D6; }
QPushButton#primaryButton, QPushButton#primaryAction, QPushButton#actionTilePrimary,
QPushButton#heroExport, QPushButton#dashboardNextActionButton {
    background: #74472E;
    color: #FFFFFF;
    border: 1px solid #74472E;
    font-weight: 850;
}
QPushButton#primaryButton:hover, QPushButton#primaryAction:hover,
QPushButton#actionTilePrimary:hover, QPushButton#heroExport:hover,
QPushButton#dashboardNextActionButton:hover {
    background: #895A3A;
    border-color: #895A3A;
}
QPushButton#secondaryButton, QPushButton#secondaryAction, QPushButton#secondaryToolButton,
QPushButton#quietButton, QPushButton#tertiaryButton {
    background: #FBF8F4;
    color: #624434;
    border: 1px solid #DDD0C5;
}
QPushButton#dangerButton { background: #FFF9F8; color: #9A4039; border: 1px solid #E3C2BE; }
QPushButton#dangerButton:hover { background: #FBEFEE; border-color: #D6A8A3; }
QPushButton:disabled { background: #EFEAE5; color: #A49A92; border-color: #E2DBD5; }

/* Forms */
QLineEdit, QComboBox, QSpinBox, QTimeEdit, QTextEdit, QListWidget {
    background: #FFFFFF;
    color: #2E2621;
    border: 1px solid #D8CEC6;
    border-radius: 8px;
    padding: 7px 9px;
    selection-background-color: #A06D4D;
    selection-color: #FFFFFF;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QTimeEdit:hover, QTextEdit:hover, QListWidget:hover {
    border-color: #C4B2A4;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QTimeEdit:focus, QTextEdit:focus, QListWidget:focus {
    border: 1px solid #8C6043;
    background: #FFFEFD;
}
QComboBox QAbstractItemView { background: #FFFFFF; border: 1px solid #D8CEC6; selection-background-color: #EEE1D7; selection-color: #34281F; }

/* Tables */
QTableWidget {
    background: #FFFFFF;
    color: #302923;
    border: 1px solid #E3DCD6;
    border-radius: 9px;
    gridline-color: #EEE8E3;
    alternate-background-color: #FBF9F7;
    selection-background-color: #EFE2D8;
    selection-color: #342920;
    outline: none;
}
QTableWidget QHeaderView::section {
    background: #F4EFEA;
    color: #5C4D43;
    border: none;
    border-right: 1px solid #E7DED7;
    border-bottom: 1px solid #DCCFC5;
    padding: 8px 9px;
    font-size: 10px;
    font-weight: 850;
}
QTableWidget::item { padding: 7px 9px; border: none; border-bottom: 1px solid #F0EBE7; }
QTableWidget::item:selected { background: #EFE2D8; color: #342920; }

/* Participant management */
QFrame#participantToolbar { background: #FBF8F4; border: 1px solid #E3D9D1; border-radius: 10px; }
QListWidget#participantList { background: #FFFFFF; border: 1px solid #E3DCD6; border-radius: 10px; padding: 4px; }
QListWidget#participantList::item { border-bottom: 1px solid #F0EBE7; padding: 9px 10px; }
QListWidget#participantList::item:hover { background: #FAF5F1; border-radius: 6px; }
QListWidget#participantList::item:selected { background: #EEE1D7; color: #33271F; border-radius: 6px; }

/* Live / tournament-day cards */
QFrame#liveOperatorFocus { background: #FFFDFB; border: 1px solid #DECDBF; border-radius: 12px; }
QFrame#liveTableCard { background: #FFFFFF; border: 1px solid #E0D6CE; border-radius: 12px; padding: 10px; }
QFrame#liveTableCard:hover { border-color: #C7AD99; }
QLabel#liveStatus { background: #F1E5DA; color: #6F432D; border-radius: 7px; padding: 6px 9px; font-weight: 850; }

/* Status / badges */
QLabel#statusBadge, QLabel#phaseStatusPill, QLabel#workflowStatusCompact {
    background: #F4ECE5;
    color: #624434;
    border: 1px solid #DFCFC2;
    border-radius: 8px;
    padding: 5px 9px;
    font-weight: 800;
}
QLabel#infoBanner, QLabel#infoBox, QLabel#phaseSummary {
    background: #FAF6F2;
    color: #5E5148;
    border: 1px solid #E6DDD6;
    border-radius: 9px;
    padding: 10px 12px;
}

/* Tabs and scrollbars */
QTabWidget::pane { background: #FFFFFF; border: 1px solid #E1D8D1; border-radius: 9px; }
QTabBar::tab { background: transparent; color: #71665E; padding: 9px 14px; border-bottom: 2px solid transparent; }
QTabBar::tab:hover { color: #74472E; }
QTabBar::tab:selected { color: #74472E; font-weight: 850; border-bottom: 2px solid #74472E; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #C2AEA0; min-height: 32px; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background: #A9846D; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #C2AEA0; min-width: 32px; border-radius: 5px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QMenuBar { background: #FCFAF7; border-bottom: 1px solid #E3DAD3; }
QMenu { background: #FFFFFF; border: 1px solid #DDD2C9; padding: 5px; }
QMenuBar::item:selected, QMenu::item:selected { background: #F0E5DC; color: #5A3928; }
QStatusBar { background: #FCFAF7; border-top: 1px solid #E3DAD3; color: #776A61; }
QToolTip { background: #2B211C; color: #FFFDFB; border: 1px solid #2B211C; padding: 6px 8px; }

/* STARTFIX 91 - MSTTS Pro dashboard refinement */
QLabel#dashboardWelcome {
    color: #2D211B;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.2px;
}
QLabel#dashboardSubtitle { color: #806F64; font-size: 12px; font-weight: 500; }
QFrame#dashboardNextAction {
    background: #FFFEFC;
    border: 1px solid #DED4CC;
    border-left: 4px solid #74472E;
    border-radius: 12px;
}
QLabel#dashboardNextActionBadge { color: #98603D; font-size: 9px; font-weight: 800; letter-spacing: 1.2px; }
QLabel#dashboardNextActionTitle { color: #31241D; font-size: 19px; font-weight: 800; }
QLabel#dashboardNextActionMessage { color: #74655B; font-size: 12px; font-weight: 500; }
QFrame#dashboardStatCard {
    background: #FFFEFC;
    border: 1px solid #E1D7CF;
    border-radius: 11px;
}
QLabel#dashboardStatIcon {
    background: #F3E9E0;
    color: #74472E;
    border: 1px solid #E4D3C5;
    border-radius: 9px;
    font-size: 17px;
    font-weight: 800;
}
QLabel#dashboardStatValue { color: #30231C; font-size: 20px; font-weight: 800; }
QLabel#dashboardStatLabel { color: #817168; font-size: 10px; font-weight: 650; }
QFrame#dashboardStatusStrip { border-bottom: 1px solid #EAE3DD; }
QLabel#dashboardStatusItem { color: #766B64; font-size: 10px; font-weight: 650; }
QLabel#dashboardSectionHeading { color: #69594F; font-size: 10px; font-weight: 800; letter-spacing: 1.1px; }
QPushButton#dashboardQuickCard {
    background: #FFFEFC;
    color: #49352A;
    border: 1px solid #E0D5CC;
    border-radius: 10px;
    padding: 11px 14px;
    text-align: left;
    font-size: 12px;
    font-weight: 700;
}
QPushButton#dashboardQuickCard:hover { background: #F8F1EB; border-color: #CDB29F; }
QFrame#dashboardManagementBar {
    background: #FAF7F3;
    border: 1px solid #E5DCD5;
    border-radius: 10px;
}
QLabel#dashboardManagementTitle { color: #81736A; font-size: 9px; font-weight: 800; letter-spacing: 1px; }


/* STARTFIX 92 - richer MSTTS dashboard colour system */
QFrame#dashboardStatCard[tone="violet"] { background: #F7F1FC; border: 1px solid #DCC9EE; }
QFrame#dashboardStatCard[tone="violet"] QLabel#dashboardStatIcon { background: #EADDF7; color: #6E35A5; border-color: #D7BFEA; }
QFrame#dashboardStatCard[tone="violet"] QLabel#dashboardStatValue { color: #4D236F; }
QFrame#dashboardStatCard[tone="violet"] QLabel#dashboardStatLabel { color: #75558D; }
QFrame#dashboardStatCard[tone="bronze"] { background: #FBF5EE; border: 1px solid #E5D1BD; }
QFrame#dashboardStatCard[tone="bronze"] QLabel#dashboardStatIcon { background: #F2E3D3; color: #87502C; border-color: #DFC4AA; }
QFrame#dashboardStatCard[tone="bronze"] QLabel#dashboardStatValue { color: #5A3522; }
QFrame#dashboardStatCard[tone="bronze"] QLabel#dashboardStatLabel { color: #8B654C; }
QFrame#dashboardStatCard[tone="green"] { background: #F0F8F2; border: 1px solid #C7E0CD; }
QFrame#dashboardStatCard[tone="green"] QLabel#dashboardStatIcon { background: #DDEFE1; color: #27663A; border-color: #BFDBC6; }
QFrame#dashboardStatCard[tone="green"] QLabel#dashboardStatValue { color: #244E31; }
QFrame#dashboardStatCard[tone="green"] QLabel#dashboardStatLabel { color: #4D7759; }
QFrame#dashboardStatCard[tone="rose"] { background: #FFF2F1; border: 1px solid #EBCBC8; }
QFrame#dashboardStatCard[tone="rose"] QLabel#dashboardStatIcon { background: #F7DEDC; color: #A33A35; border-color: #E8C1BE; }
QFrame#dashboardStatCard[tone="rose"] QLabel#dashboardStatValue { color: #7D2E2A; }
QFrame#dashboardStatCard[tone="rose"] QLabel#dashboardStatLabel { color: #9A5C58; }
QFrame#dashboardStatCard[tone="violet"]:hover { background: #F2E9FA; border-color: #C9ABE2; }
QFrame#dashboardStatCard[tone="bronze"]:hover { background: #F7ECDF; border-color: #D7B795; }
QFrame#dashboardStatCard[tone="green"]:hover { background: #E8F4EB; border-color: #ADD2B6; }
QFrame#dashboardStatCard[tone="rose"]:hover { background: #FCE9E7; border-color: #DFAEAA; }
QFrame#dashboardNextAction { background: #FFFDFC; border: 1px solid #DDCEC3; border-left: 5px solid #9A5A2E; }
QPushButton#dashboardNextActionButton { background: #8A4F29; }
QPushButton#dashboardNextActionButton:hover { background: #A76537; }


/* STARTFIX 93 - visual parity pass with approved MSTTS Pro concept */
QWidget#dashboardContent { background: #F8F3EE; }
QLabel#dashboardWelcome { color: #241813; font-size: 30px; font-weight: 900; }
QLabel#dashboardSubtitle { color: #795947; font-size: 12px; font-weight: 600; padding-bottom: 4px; }
QFrame#dashboardNextAction {
    background: #FFFDFC;
    border: 1px solid #D9C2AE;
    border-left: 5px solid #A8642F;
    border-radius: 14px;
}
QLabel#dashboardNextActionBadge { color: #9A5B2D; font-size: 9px; font-weight: 900; letter-spacing: 1.4px; }
QLabel#dashboardNextActionTitle { color: #2D1D16; font-size: 21px; font-weight: 900; }
QPushButton#dashboardNextActionButton {
    background: #985923; color: white; border: none; border-radius: 10px;
    padding: 13px 20px; font-size: 13px; font-weight: 900;
}
QPushButton#dashboardNextActionButton:hover { background: #B06B31; }
QFrame#dashboardStatusStrip { background: transparent; border-bottom: 1px solid #DDCDBF; }
QLabel#dashboardStatusItem { color: #7D573E; font-size: 10px; font-weight: 800; }

QFrame#dashboardStatCard { border-radius: 14px; min-height: 82px; }
QFrame#dashboardStatCard[tone="violet"] { background: #F3E9FF; border: 1px solid #CDB1EA; }
QFrame#dashboardStatCard[tone="violet"] QLabel#dashboardStatIcon { background: #E2CFF7; color: #5E258F; border-color: #C7A7E5; }
QFrame#dashboardStatCard[tone="violet"] QLabel#dashboardStatValue { color: #421D66; }
QFrame#dashboardStatCard[tone="violet"] QLabel#dashboardStatLabel { color: #6D438A; }
QFrame#dashboardStatCard[tone="bronze"] { background: #FFF3E7; border: 1px solid #E2BE9D; }
QFrame#dashboardStatCard[tone="bronze"] QLabel#dashboardStatIcon { background: #F2D8BD; color: #88491E; border-color: #DCB58F; }
QFrame#dashboardStatCard[tone="bronze"] QLabel#dashboardStatValue { color: #5C321B; }
QFrame#dashboardStatCard[tone="green"] { background: #EAF7EE; border: 1px solid #B6DCC1; }
QFrame#dashboardStatCard[tone="green"] QLabel#dashboardStatIcon { background: #CFEBD7; color: #176334; border-color: #A9D4B5; }
QFrame#dashboardStatCard[tone="green"] QLabel#dashboardStatValue { color: #174C2B; }
QFrame#dashboardStatCard[tone="rose"] { background: #FDEBEC; border: 1px solid #E8B7B9; }
QFrame#dashboardStatCard[tone="rose"] QLabel#dashboardStatIcon { background: #F6D0D2; color: #9B282E; border-color: #E5ADB0; }
QFrame#dashboardStatCard[tone="rose"] QLabel#dashboardStatValue { color: #7E2529; }
QLabel#dashboardStatValue { font-size: 24px; font-weight: 900; }
QLabel#dashboardStatLabel { font-size: 10px; font-weight: 800; }
QLabel#dashboardStatIcon { border-radius: 11px; font-size: 19px; font-weight: 900; }

QFrame#sidebar { background: #21150F; border: none; }
QLabel#sidebarProductName { color: #FFFFFF; font-weight: 900; }
QLabel#sidebarProductSubtitle { color: #CDAF98; }
QFrame#dashboardManagementBar { background: #FFFCF9; border: 1px solid #DDC9B8; border-radius: 12px; }
QLabel#dashboardManagementTitle { color: #704A34; font-weight: 900; letter-spacing: 1.2px; }
QPushButton#dashboardQuickCard { background: #FFFCF9; border: 1px solid #DDC9B8; border-radius: 12px; }
QPushButton#dashboardQuickCard:hover { background: #F8EDE4; border-color: #B98764; }
\n\n/* STARTFIX 94 - branded dashboard shell and stronger visual hierarchy */\nQFrame#dashboardHero {\n    background: #FFFDFC;\n    border: 1px solid #DCCABC;\n    border-radius: 15px;\n}\nQLabel#dashboardHeroEyebrow { color: #9A633E; font-size: 9px; font-weight: 900; letter-spacing: 1.5px; }\nQLabel#dashboardHeroSlogan { color: #6B35A1; font-size: 13px; font-weight: 900; letter-spacing: .5px; padding: 4px 8px; }\nQLabel#dashboardWelcome { color: #241813; font-size: 31px; font-weight: 900; }\nQLabel#dashboardSubtitle { color: #765B4B; font-size: 12px; font-weight: 600; }\nQFrame#dashboardNextAction {\n    background: #FFFCF8;\n    border: 1px solid #D8B99F;\n    border-left: 6px solid #A45F2A;\n    border-radius: 14px;\n}\nQPushButton#dashboardNextActionButton {\n    background: #96541F; color: #FFFFFF; border: none; border-radius: 11px;\n    padding: 14px 22px; font-size: 13px; font-weight: 900;\n}\nQFrame#dashboardStatCard[tone="violet"] { background: #F5ECFF; border: 1px solid #CDB1EA; }\nQFrame#dashboardStatCard[tone="bronze"] { background: #FFF2E5; border: 1px solid #E0B78F; }\nQFrame#dashboardStatCard[tone="green"] { background: #E9F7ED; border: 1px solid #ADD5B8; }\nQFrame#dashboardStatCard[tone="rose"] { background: #FDE9EA; border: 1px solid #E4ADB0; }\nQFrame#dashboardManagementBar { background: #FFFDFC; border: 1px solid #DCCABC; border-radius: 13px; }\nQFrame#sidebar { background: #1E130E; }\nQLabel#navSection, QLabel#navSectionLabel { color: #CBA98F; letter-spacing: 1.2px; font-weight: 900; }\n
/* STARTFIX 95 — graphical tournament route */
QFrame#progressHeader {
    min-height: 88px; max-height: 96px;
    background: #FFFEFC; border: 1px solid #DED1C6; border-radius: 15px;
}
QFrame#progressRoute { background: transparent; border: none; }
QPushButton#progressStep {
    min-width: 30px; max-width: 30px; min-height: 30px; max-height: 30px;
    padding: 0; margin: 0; border-radius: 15px;
    background: #F0EBE6; color: #6E6057; border: 1px solid #D8CEC5;
    font-size: 11px; font-weight: 850;
}
QPushButton#progressStep:hover { background: #E8DED5; color: #5B3927; border-color: #CDAE95; }
QPushButton#progressStep[active="true"] { background: #EAD8C9; color: #75482F; border-color: #CDAA8E; }
QPushButton#progressStep[current="true"] { background: #9B5C2D; color: white; border: 2px solid #9B5C2D; }
QLabel#progressStepLabel { color: #786B62; font-size: 10px; font-weight: 650; padding-top: 1px; }
QLabel#progressStepLabel[active="true"] { color: #68422D; font-weight: 750; }
QLabel#progressStepLabel[current="true"] { color: #8B4E25; font-weight: 900; }
QFrame#progressConnector { background: #DDD5CE; border: none; margin-left: 2px; margin-right: 2px; }
QFrame#progressConnector[active="true"] { background: #B87948; }
QLabel#progressSubtitle { color: #9B5C2D; font-size: 11px; font-weight: 750; }


/* STARTFIX 96 — branded dashboard hero parity */
QFrame#dashboardHero {
    background: #FFFDFC;
    border: 1px solid #DCCFC5;
    border-radius: 16px;
}
QLabel#dashboardHeroEyebrow { color: #9A633F; font-size: 9px; font-weight: 900; letter-spacing: 1.5px; }
QLabel#dashboardWelcome { color: #2D1D16; font-size: 29px; font-weight: 900; }
QLabel#dashboardSubtitle { color: #70594B; font-size: 12px; font-weight: 500; }
QLabel#dashboardHeroSlogan { color: #6A3520; font-size: 15px; font-weight: 900; font-style: italic; padding: 4px 18px; }
QFrame#dashboardHeroClock {
    background: #F8F1EA;
    border: 1px solid #E1D3C7;
    border-radius: 11px;
    min-width: 170px;
}
QLabel#dashboardHeroDate { color: #6E5547; font-size: 10px; font-weight: 700; }
QLabel#dashboardHeroTime { color: #2E1E17; font-size: 25px; font-weight: 900; }
QFrame#dashboardNextAction { background: #FFFEFC; border: 1px solid #DCCEC2; border-left: 5px solid #A45F2D; border-radius: 13px; }
QPushButton#dashboardNextActionButton { background: #925426; color: #FFFFFF; border: 0; border-radius: 9px; padding: 12px 20px; font-weight: 900; }
QPushButton#dashboardNextActionButton:hover { background: #AD6935; }

/* STARTFIX 97 — visual tournament stage + horizontal Pro management */
QFrame#dashboardArena {
    background: transparent;
    border: none;
    border-radius: 16px;
}
QLabel#dashboardArenaEyebrow {
    color: #EBCDBA;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1.5px;
    background: transparent;
}
QLabel#dashboardArenaTitle {
    color: #FFFFFF;
    font-size: 23px;
    font-weight: 900;
    background: transparent;
}
QLabel#dashboardArenaSubtitle {
    color: #F1E4DA;
    font-size: 11px;
    font-weight: 550;
    background: transparent;
}
QLabel#dashboardArenaBadge {
    color: #FFF5EB;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .7px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 10px;
    padding: 9px 12px;
}
QFrame#dashboardManagementBar {
    background: #FFFEFC;
    border: 1px solid #D8C7B9;
    border-radius: 14px;
}
QLabel#dashboardManagementTitle {
    color: #493126;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.2px;
}
QLabel#dashboardManagementSubtitle {
    color: #806A5D;
    font-size: 10px;
    font-weight: 500;
}
QPushButton#dashboardManagementPrimary {
    min-height: 40px;
    background: #8D5127;
    color: #FFFFFF;
    border: 1px solid #8D5127;
    border-radius: 10px;
    padding: 0 16px;
    font-size: 11px;
    font-weight: 850;
}
QPushButton#dashboardManagementPrimary:hover { background: #A86433; border-color: #A86433; }
QPushButton#dashboardManagementSecondary,
QToolButton#dashboardManagementMore {
    min-height: 40px;
    background: #FFFDFC;
    color: #55392A;
    border: 1px solid #D5C1B1;
    border-radius: 10px;
    padding: 0 15px;
    font-size: 11px;
    font-weight: 800;
}
QPushButton#dashboardManagementSecondary:hover,
QToolButton#dashboardManagementMore:hover { background: #F7ECE3; border-color: #B88D6F; }
QMenu {
    background: #FFFDFC;
    color: #493126;
    border: 1px solid #D8C7B9;
    border-radius: 8px;
    padding: 5px;
}
QMenu::item { padding: 7px 18px; border-radius: 5px; }
QMenu::item:selected { background: #F2E3D7; color: #6E3E20; }

/* STARTFIX 98 - professional sidebar and navigation */
QFrame#sidebar { background: #1B120E; border: none; }
QLabel#brandLogo { background: transparent; padding: 3px; }
QLabel#sidebarProductName { color: #FFF9F3; font-size: 18px; font-weight: 900; letter-spacing: 1.4px; padding-top: 0; }
QLabel#sidebarProductSubtitle { color: #BFA28E; font-size: 9px; font-weight: 650; padding-bottom: 2px; }
QFrame#navDivider { background: #4A3428; color: #4A3428; max-height: 1px; border: none; margin: 1px 4px; }
QLabel#navSectionLabel { color: #A9856E; background: transparent; border: none; font-size: 8px; font-weight: 900; letter-spacing: 1.6px; padding: 7px 10px 3px 10px; }
QPushButton#navButton { min-height: 34px; max-height: 38px; background: transparent; color: #DCCFC6; border: none; border-left: 3px solid transparent; border-radius: 8px; padding: 5px 10px; text-align: left; font-size: 11px; font-weight: 650; }
QPushButton#navButton:hover { background: #2A1C16; color: #FFFFFF; border-left-color: #76513C; }
QPushButton#navButton:checked { background: #F5EEE8; color: #4A2B1D; border-left: 4px solid #B36B34; font-weight: 900; }
QFrame#sidebarSignature { background: #211711; border: 1px solid #3D2A20; border-radius: 9px; }
QLabel#sidebarSignatureTitle { color: #D6B69D; font-size: 8px; font-weight: 900; letter-spacing: 1.1px; }
QLabel#sidebarSignatureLine { color: #8F7463; font-size: 7px; font-weight: 650; }
QLabel#sidebarVersion { color: #6F5A4D; font-size: 7px; }

/* STARTFIX 99 - premium readable tournament progress timeline */
QFrame#progressHeader {
    min-height: 104px;
    max-height: 112px;
    background: #FFFDFC;
    border: 1px solid #D9C8BA;
    border-radius: 15px;
}
QLabel#progressTitle {
    color: #5A3928;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1.6px;
}
QLabel#progressSubtitle {
    color: #A05D2D;
    background: #F7ECE3;
    border: 1px solid #E4D1C1;
    border-radius: 8px;
    padding: 4px 9px;
    font-size: 9px;
    font-weight: 850;
}
QFrame#progressRoute { background: transparent; border: none; }
QPushButton#progressStep {
    min-width: 38px; max-width: 38px;
    min-height: 38px; max-height: 38px;
    padding: 0px;
    margin: 0px;
    border-radius: 19px;
    background: #F2ECE7;
    color: #7B6A60;
    border: 2px solid #DDD1C8;
    font-size: 12px;
    font-weight: 900;
}
QPushButton#progressStep:hover {
    background: #EEE2D8;
    color: #5A3726;
    border-color: #CDA98E;
}
QPushButton#progressStep[active="true"] {
    background: #F0DFD1;
    color: #75442A;
    border-color: #D4AE90;
}
QPushButton#progressStep[completed="true"] {
    background: #E7F2E9;
    color: #2E6A3B;
    border-color: #AFCDB6;
}
QPushButton#progressStep[current="true"] {
    background: #955526;
    color: #FFFFFF;
    border: 2px solid #955526;
}
QLabel#progressStepLabel {
    color: #7C6C62;
    background: transparent;
    border: none;
    font-size: 9px;
    font-weight: 650;
    padding-top: 3px;
}
QLabel#progressStepLabel[completed="true"] { color: #477251; font-weight: 750; }
QLabel#progressStepLabel[current="true"] { color: #82491F; font-weight: 900; }
QFrame#progressConnector {
    background: #DED4CC;
    border: none;
    min-height: 2px; max-height: 2px;
    margin-left: 8px; margin-right: 8px;
}
QFrame#progressConnector[active="true"] { background: #B87948; }


/* STARTFIX 100 - final progress timeline: number-only nodes, clean labels */
QFrame#progressHeader { min-height: 108px; max-height: 116px; }
QFrame#progressRoute { background: transparent; border: none; }
QPushButton#progressStep {
    min-width: 36px; max-width: 36px; min-height: 36px; max-height: 36px;
    border-radius: 18px; padding: 0px; margin: 0px; font-size: 12px; font-weight: 900;
}
QLabel#progressStepLabel { min-height: 18px; padding: 3px 2px 0px 2px; font-size: 9px; }
QFrame#progressConnector { min-height: 2px; max-height: 2px; margin-left: 6px; margin-right: 6px; }

/* STARTFIX 101 - premium sidebar matching the approved visual concept */
QFrame#sidebar { background: #1B100B; border: none; }
QLabel#brandLogo { background: transparent; padding: 0px 8px 2px 8px; }
QLabel#sidebarProductName { color: #FFF9F2; font-size: 17px; font-weight: 900; letter-spacing: 1.2px; padding: 0; }
QLabel#sidebarProductSubtitle { color: #C5A994; font-size: 8px; font-weight: 650; line-height: 1.25; padding: 0 0 5px 0; }
QFrame#navDivider { background: #573824; color: #573824; max-height: 1px; border: none; margin: 2px 2px; }
QLabel#navSectionLabel { color: #C28A5E; background: transparent; border: none; font-size: 8px; font-weight: 900; letter-spacing: 1.7px; padding: 7px 8px 2px 8px; }
QPushButton#navButton { min-height: 32px; max-height: 35px; background: transparent; color: #E6D9CF; border: none; border-left: 3px solid transparent; border-radius: 8px; padding: 4px 10px; text-align: left; font-size: 10px; font-weight: 650; }
QPushButton#navButton:hover { background: #2A1A12; color: #FFFFFF; border-left-color: #76513C; }
QPushButton#navButton:checked { background: #F8F1EB; color: #3D2418; border-left: 4px solid #C36D28; font-weight: 900; }
QFrame#sidebarStatusCard { background: #24160F; border: 1px solid #54351F; border-radius: 11px; }
QLabel#sidebarStatusTitle { color: #F7EDE5; background: transparent; border: none; font-size: 10px; font-weight: 900; }
QLabel#sidebarStatusDetail { color: #BCA491; background: transparent; border: none; font-size: 8px; font-weight: 600; line-height: 1.25; }

/* STARTFIX 102 — Brown Visual Dashboard, based on the approved mock-up */
