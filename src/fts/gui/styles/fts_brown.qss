/* STARTFIX 137 - Presentation-parity monochrome premium Leitstand.
   Scoped to liveMode so preparation/settings pages retain their normal workspace. */
QWidget#mainContent[liveMode="true"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #1E100B, stop:0.48 #351B10, stop:1 #160B08);
    color: #FFF3E8;
}
QWidget#mainContent[liveMode="true"] QScrollArea#pageScrollArea,
QWidget#mainContent[liveMode="true"] QScrollArea#pageScrollArea > QWidget,
QWidget#mainContent[liveMode="true"] QScrollArea#pageScrollArea > QWidget > QWidget,
QWidget#mainContent[liveMode="true"] QWidget#liveCenterContent,
QWidget#mainContent[liveMode="true"] QScrollArea#liveCenterScroll,
QWidget#mainContent[liveMode="true"] QScrollArea#liveCenterScroll > QWidget,
QWidget#mainContent[liveMode="true"] QScrollArea#liveCenterScroll > QWidget > QWidget {
    background: transparent; color:#FFF3E8; border:none;
}
QWidget#mainContent[liveMode="true"] QFrame#workspaceHeader,
QWidget#mainContent[liveMode="true"] QFrame#progressHeader,
QWidget#mainContent[liveMode="true"] QFrame#workflowQuickActions {
    background:rgba(37,18,11,0.94); border:1px solid #7132A8; border-radius:14px;
}
