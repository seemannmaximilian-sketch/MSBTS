QFrame#liveTableCard QLabel#liveTableTime { font-size: 11px; padding: 2px 5px; }
QFrame#liveTableCard QLabel#mutedText { font-size: 10px; padding: 2px 5px; }
QFrame#liveTableCard QLabel#liveTablePlayers { font-size: 15px; padding: 2px 2px; }
QFrame#liveTableCard QLabel#liveTableScorer { font-size: 11px; padding: 3px 6px; }
