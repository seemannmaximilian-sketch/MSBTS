}
QFrame#liveSummaryCard { min-height: 62px; border-radius: 11px; }
QLabel#liveSectionTitle { font-size: 12px; }
QLabel#sectionEyebrow { font-size: 10px; }

/* STARTFIX 130 - approved full dark-brown Leitstand */
QWidget#mainContent {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #25140D, stop:0.55 #3B2115, stop:1 #21120C);
}
QFrame#workspaceHeader, QFrame#workflowQuickActions, QFrame#liveStatusStrip,
QFrame#liveOperatorFocus, QFrame#liveSummaryCard {
    background: rgba(43,22,14,0.90); border:1px solid #8B512D; border-radius:12px;
}
QFrame#workspaceHeader QLabel, QFrame#workflowQuickActions QLabel,
QFrame#liveStatusStrip QLabel, QFrame#liveOperatorFocus QLabel, QFrame#liveSummaryCard QLabel {
    color:#F8EBDD; background:transparent;
}
QLabel#workspaceTitle { color:#FFFFFF; }
QLabel#workspaceSubtitle, QLabel#workspaceTournament { color:#E8C8AE; }
QPushButton#sidebarToggle, QPushButton#workspaceBackButton,
QPushButton#workflowQuickButton, QPushButton#workspacePrimaryAction,
QPushButton#liveOperatorFocusAction {
    background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #5B301C,stop:1 #3A1E13);
    color:#FFF4E9; border:1px solid #B34CFF; border-radius:9px; font-weight:850;
}
QPushButton#workflowQuickButton[state="done"] { background:#3E271A; color:#F4E6DA; border-color:#815134; }
QPushButton#workflowQuickButton[state="current"], QPushButton#workflowQuickButton[state="active"],
QPushButton#workflowQuickButton[state="recommended"], QPushButton#workspacePrimaryAction,
QPushButton#liveOperatorFocusAction {
    background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #A85B28,stop:1 #743417);
    color:#FFFFFF; border-color:#D18A50;
}
QLabel#workflowStatusCompact, QLabel#statusBadge, QLabel#phaseStatusPill {
    background:#4A2819; color:#FFE4CD; border:1px solid #9B6039; border-radius:8px;
}

/* STARTFIX 131 - approved bronze live-center parity */
QWidget#liveCenterContent,
QScrollArea#liveCenterScroll,
QScrollArea#liveCenterScroll > QWidget > QWidget {
    background: transparent;
}
QScrollArea#liveCenterScroll { border:none; }
QFrame#livePhaseHero {
    background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #2A140C,stop:0.55 #4B2717,stop:1 #211008);
    border:1px solid #A76031; border-radius:12px;
}
QFrame#liveStatusStrip {
    background:rgba(37,18,11,0.72); border:none; border-bottom:1px solid #744127; border-radius:0;
}
QFrame#liveOperatorFocus {
    background:rgba(39,19,12,0.88); border:1px solid #8E512B; border-radius:11px;
}
QFrame#liveTableCard {
    min-height:160px; max-height:176px;
    background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #29150D,stop:0.55 #402116,stop:1 #090619);
    border:1px solid #8D4E28; border-radius:12px; padding:5px;
}
QFrame#liveTableCard[matchState="preparing"], QFrame#liveTableCard[matchState="running"], QFrame#liveTableCard[matchState="result_pending"] {
    background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #32180E,stop:1 #512814);
    border-color:#A95E2B;
}
QFrame#liveTableCard[matchState="free"] { background:#261710; border-color:#70442F; }
QLabel#livePlayerChip {
    min-height:32px; background:rgba(255,255,255,0.055); color:#FFF4E8;
    border:1px solid #7F4A30; border-radius:7px; padding:4px 6px;
    font-size:13px; font-weight:900;
}
QLabel#liveVsBadge {
    min-height:32px; max-height:32px; background:#9A4F20; color:white;
    border:1px solid #C9783F; border-radius:16px; font-size:11px; font-weight:950;
}
QFrame#liveTableCard QLabel#liveTableScorer {
    background:rgba(154,79,32,0.26); color:#FFE8D4; border:1px solid #9C5A34;
}
QFrame#liveSummaryCard {
    background:rgba(40,20,13,0.84); border:1px solid #794429; border-radius:10px;
}
QLabel#liveSectionTitle { color:#FAF7FF; font-weight:900; }
QLabel#sectionEyebrow { color:#F0C29A; font-weight:900; }
QProgressBar { background:#2B1810; border:1px solid #774329; color:#F8EBDD; }
QProgressBar::chunk { background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #A95925,stop:1 #D18A50); }

/* STARTFIX 132 - approved dark-brown shell + right-side MSTTS watermark */
