QPushButton#secondaryButton:hover,
QPushButton#tertiaryButton:hover {
    background:#2B1251;
    border-color:#B63DF1;
}
QLabel#startSectionTitle,
QLabel#startExamplesLabel {
    color:#E45CFF;
    font-weight:950;
