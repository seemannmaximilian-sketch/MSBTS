}
QLabel#startTitle {
    color: #FFFFFF;
    font-size: 32px;
    font-weight: 950;
}
QFrame#startPageShell QLabel#mutedText {
    color: #C4B1DE;
    font-size: 13px;
}
QPushButton#startPrimaryButton {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #7B1ED0, stop:1 #C026F5);
    color:#FFFFFF;
    border:1px solid #E261FF;
    border-radius:12px;
    padding:12px 18px;
    font-weight:900;
}
QPushButton#startPrimaryButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #9029E8, stop:1 #D63DFF);
}
QPushButton#startSecondaryButton,
QPushButton#secondaryButton,
QPushButton#tertiaryButton {
    background:#1A0C34;
