QPushButton#workflowQuickButton[state="current"] { background:#8D2CFF; color:#FFFFFF; border-color:#B85CFF; }
QScrollBar:vertical, QScrollBar:horizontal { background:#070214; border:none; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background:#7B36AF; border:1px solid #A94CFF; border-radius:6px; }
QStatusBar { background:#05010E; color:#CDBBE8; border-top:1px solid #4A1D72; }


